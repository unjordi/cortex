// 01 — Instalación / actualización del cerebro (cortex)  ·  FUENTE editable (Graphviz .dot)
// Render:  gen-charts.sh → .svg (vista, graphviz) + .drawio (editable en draw.io). Ver CONVENCIONES.md.
// Dibuja el estado REAL del código (MANIFEST + install-brain.sh + aviso-drift-cerebro.sh). El cerebro vive
// SOLO en global: NO hay propagación por-repo (sincronizar-cerebro y los tiers both/repo se retiraron);
// una copia por-repo vieja se retira con install-brain.sh --limpiar-repo.
// Convención de color = CONVENCIONES.md (🔴=DENY · 🚧=hueco/deuda · ⚠=escribe git).
digraph flujos {
  graph [bgcolor="#1b1712", rankdir=TB, fontname="Helvetica", splines=true,
         nodesep=0.35, ranksep=0.55, pad=0.25];
  node  [fontname="Helvetica", fontsize=12, fontcolor="#f2ede6", shape=box,
         style="rounded,filled", fillcolor="#2b2b2b", color="#8a8a8a", penwidth=1.5];
  edge  [color="#d97757", fontname="Helvetica", fontsize=10, fontcolor="#cfc8c0", penwidth=1.4];

  // ─────────────────────────── LEYENDA (regla dura del skill diagramar) ───────────────────────────
  // >>> LEYENDA-ARBOL (generado por gen-leyenda-arbol.sh desde el árbol del README — NO editar a mano) >>>
  subgraph cluster_leyenda {
    label="LEYENDA — árbol completo del cerebro (fuente: README.md)"; labeljust="l"; fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";
    LEY_ARBOL [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#5fa89e" bgcolor="#1b1712">
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>🔒 Hooks Forzosos</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔗 merge-develop-guard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">push directo a develop·main, o MR sin --squash/sin tu OK → denegado; a main exige OK súper-explícito</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💸 delegacion-gate</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">delegar al llegar al 90% de tu ventana 5h → pide tu OK</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛑 limite-gasto</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">sin ventana 5h Y sin overage (ambos agotados) → freno duro</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧵 forzar-checkpoint</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">Stop: al CRUZAR el 92% de GOV frena el cierre del turno hasta que se invoque la skill checkpoint (tope configurable; + visible + sonoro); re-arma tras compact (GLOBAL)</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>🔔 Automático</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🖥️ entorno-maquina-guard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">commit de algo machine-specific (aliases/rutas de $HOME/Rosetta/entorno-maquina.md) al .claude/memory/ del repo → avisa</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🚧 no-bypass-deploy</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">correr el instalador/deploy a mano (install-brain.sh/deploy.sh, helm/kubectl apply -f, aun tras sudo/nohup/VAR=/source) en vez de la herramienta oficial (el widget) → avisa (fail-safe: no --dry-run/--help/CI)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌳 proteger-arbol</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">git destructivo que orfanaría commits sin pushear → avisa (fan-out: usa worktree aislado)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛡️ proteger-fuente-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">editar la copia INSTALADA de un hook/skill que tiene fuente en el clon → avisa (se perdería en el próximo sync); + un Edit a settings.json que decablea un hook del cerebro o agrega un escape de guard → avisa (tu propio candado) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧹 barrer-ramas</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">al abrir sesión / al punto del merge barre en 2º plano ramas locales + remota huérfana + worktrees ya integrados (zombie squash-safe; throttle 24h) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💾 exportar-sesion-master</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">auto-export de las sesiones *-master a ~/.claude-sessions (o Drive); detached, sobrevive el cleanup de 30 días (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🗂️ checkpoint-mecanico</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">PreCompact: extractor mecánico (streaming, 0 tokens) escribe el andamio del TRAMO VIVO a hilo-mental-actual.andamio.md (GLOBAL; el skill lo regenera con --self --ensure)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📝 delegacion-registrar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">materializa el "pregunta una sola vez"</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧵 rehidratar-hilo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reinyecta hilo-mental-actual.md + el andamio (si es más fresco) al abrir/retomar/compactar (GLOBAL) — gate de frescura + edad</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📈 aviso-contexto</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">al umbral ALTO del punto REAL de compact (80%/92% de autoCompactWindow o la ventana efectiva; % honesto, respeta autoCompactEnabled): VUELCA el checkpoint mecánico solito y ORDENA /checkpoint+/compact. No gotea (silencio bajo el umbral, 1 disparo + 1 escalada) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧬 aviso-drift-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">la copia GLOBAL del cerebro (hooks/libs/skills + el bloque de normas de ~/.claude/CLAUDE.md) quedó atrás de la fuente o se editó en vivo → aviso (warn-only, throttle propio por frente). El cerebro ya no viaja por-repo (solo global). Al moverse el cerebro, NUDGE a correr la DUPLA (suficiencia+coherencia; contra la firma si hay AGENTS.md, si no sugiere instanciarla) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧭 sesion-inicio</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reinyecta rama + norma + memoria al abrir (BOTH)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌾 recordar-cosechar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">espejo automático del TaskList vivo → bloque fenced en estado-proyecto.md (determinista, sin LLM) (BOTH)</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>📜 Normas</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🎯 Definition of Done</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">verde técnico ≠ Done/Listo/Ya Quedó; exige QA o un OK explícito</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🪞 Doc &lt;= realidad</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">cambió algo → su doc se actualiza en la tanda</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌿 Flujo de git</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ramita → MR → develop; main es release-only</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💰 Costo de delegación</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">gratis / incluido / con costo, según tu cuota</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>💡 Skills</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📦 cerrar-slice</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">build+tests+memoria al día + MR con resumen curado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💾 checkpoint</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">vuelca el HILO a memoria para compactar sin perderlo (proactivo)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🗂️ to-do</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">carga la interfaz de tareas del harness desde el backlog durable (estado-proyecto.md)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💧 rehidratar-hilo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">relee el HILO a mano (gemelo del hook; respaldo si un update del CLI rompe el auto-rehidratado)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛟 reconstruir-contexto</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">RED DE EMERGENCIA cuando el checkpoint quedó pobre y /compact fundió el hilo: excava andamio→backlog→transcript y cierra re-volcando con checkpoint</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🗺️ diagramar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">diagramas por destino: draw.io por defecto (skill oficial drawio) · Mermaid en .md versionado (verse en GitHub)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔬 auditar-proceso-algoritmo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">auditor experto read-only (proceso industrial + algoritmo) → hallazgos priorizados; se alimenta de los flowcharts de diagramar</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🩺 auditar-coherencia-cerebro fan-out read-only sobre el PROPIO cerebro (guards+flowcharts+doc): evasiones/huecos/drift, verificado por ejecución → loop hasta converger; modo-cerebro de auditar-proceso-algoritmo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0"> </font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧪 auditar-suficiencia-operativa</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">¿ALCANZA la doc para HACER el trabajo sin romper nada ni re-investigar? tareas reales ✅/⚠️/❌ con archivo:línea + RE-auditar tras arreglar</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧬 auditor-semantico</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">¿el código HACE lo que queremos? Capa 1 checks deterministas (scripts/, gratis, en CI) + Capa 2 criterio LLM sobre invariantes-semanticos.yml; motor genérico, catálogo por-repo</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📐 canonizar-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">DUEÑO del ciclo de vida del cerebro de un proyecto, 4 modos sobre 1 maquinaria: sembrar (nace nativo, sin symlinks) · canonizar (firma-árbol: git mv a dom-/dev-/ux-/qa-, verifica 1:1 con verificar-firma-canonica.sh) · consolidar (dupla → positivar → desinflar → convergencia → FIRMA) · reconciliar (semanal, minis de devs → develop)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🪶 desinflar-memorias</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">adelgaza un árbol de memorias sin perder lecciones: la narrativa se colapsa a su lección, los mitos descartados se mudan al cementerio.md (una lápida por ID content-hash 🪦#&lt;id&gt;)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">☀️ positivar-doc</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reescribe answer-first: 'ESTO SÍ' (método correcto) antes del 'ESTO NO'</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🎓 investigar-dominio</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ponte experto en un dominio (fan-out DOC-FIRST) → memorias durables + skills</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📚 construir-missing-manual</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">fabrica el manual/wiki de referencia exhaustivo que no existe (fan-out que investiga 1× y hornea) → artefacto consultable OFFLINE</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🚚 reubicar-master</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">muda una sesión master COMPLETA a otro repo (brain-master → cortex) sin residuo: transcript+cwd, cerebro, slug y refs atómicas</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛰️ coordinar-claudes</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">coordina otros masters en nombre del usuario: despierta (desde los transcripts, no masters.json) · encarga la cola · vigila (commit/colgado/muerto) · destraba · verifica con evidencia · releva OKs del usuario</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔍 zoom-screenshot</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">recorta y amplía regiones de una captura (ffmpeg) para leer texto fino ilegible</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔩 ingenieria-inversa-gui-db-navegador</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ingeniería inversa de app legacy GUI+BD: driving la UI vía navegador + diff de la BD antes/después = doc con evidencia real</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📕 markdown-a-pdf</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">convierte .md a PDF pulido y distribuible vía md-to-pdf (npx, sin instalar) con el gotcha de --css y QA visual real</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🕹️ control-gui-remota-por-ssh</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ver/operar una GUI remota por SSH sin VNC/RDP — screenshot/click/teclado DPI-aware; Windows·Linux·Mac completos (multi-monitor + captura por-ventana)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔁 mandato-loop</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">el MOLDE para redactar un mandato de `/loop` de épica/lote (cómo se redacta + el bloque text con todas sus secciones)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌙 turno-nocturno</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">protocolo del turno de noche: eco del contrato, decide-dentro-de-la-cerca, grants durables a disco</font></td></tr>
      </table>>];
    LEY_VAL [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#5fa89e" bgcolor="#1b1712">
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>valencia de color</b></font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#7fb069"><font color="#f2ede6">🟢</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">OK / pasa</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#e08e45"><font color="#f2ede6">🟠</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">aviso / ASK (no bloquea)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c9a227"><font color="#f2ede6">🟡</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">latente / frágil (funciona hoy, sin garantía)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c0392b"><font color="#f2ede6">🔴</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">DENY / bloqueo (guard OK)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#9e9e9e"><font color="#f2ede6">🚧</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">hueco / deuda (por construir)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">⚠</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">el paso ESCRIBE git</font></td></tr>
      </table>>];
    LEY_ARBOL -> LEY_VAL [style=invis];
  }
  // <<< LEYENDA-ARBOL <<<

  // ───────────────────────────────────── EL PROCESO ─────────────────────────────────────
  subgraph cluster_f8 {
    label="01 · Instalación / actualización del cerebro   (bootstrap.sh · install-brain · bootstrap-claude · aviso-drift GLOBAL · widget ⬆)   —   el cerebro vive SOLO en global";
    fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";

    IN       [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
              label="instalar o actualizar el cerebro\nen esta máquina / repo"];

    // MANIFEST como FUENTE ÚNICA — de aquí DERIVAN las dos rutas de despliegue.
    MANIF    [color="#7fb069",
              label="🟢  brain/hooks/MANIFEST = FUENTE ÚNICA\ndeclara por hook su TIER {global} + KIND {hook|lib|script} (un tier `retirado` es una lápida).\nDe aquí DERIVA la lista de despliegue GLOBAL y el drift-check de test-brain\n(antídoto a las 2 listas curadas por separado que divergían). Ya no hay tiers por-repo (both/repo)."];

    AMBITO   [shape=diamond, fillcolor="#2b2622", color="#d97757", label="¿ámbito?"];

    // ── Ruta A: GLOBAL (máquina) = install-brain.sh ──
    GVEZ     [shape=diamond, fillcolor="#2b2622", color="#d97757", label="GLOBAL (máquina):\n¿1ª vez, actualizar, o self-heal?"];
    GBOOT    [color="#c0392b", penwidth=3,
              label="⚠ ESCRIBE git · 🟢  bootstrap.sh — ENTRADA REAL en máquina fresca Y VÍA OFICIAL\npara ACTUALIZAR (bootstrap.sh:9 'Idempotente: re-correrlo solo actualiza')\n(curl -fsSL …/bootstrap.sh | bash): instala prereqs con el gestor del OS (git/jq/node;\nen macOS exige brew+Xcode CLT) + clona o `git checkout -B main origin/main` para\nALINEAR el clon a origin/main en ~/.cortex (fuerza-alinea, descarta rama/commits\nleftover — mismo comando que WID_ACT; `CLAUDE_BRAIN_REF=<rama>` instala otra rama, p. ej. develop en QA) + `mv`/`git remote set-url` si migra clones\nviejos claude-brain→cortex + despacha a ./install.sh (Linux/KDE) o macos/install.sh\n(macOS) — en el flujo de bootstrap, install-brain.sh es el instalador INTERNO que esos\nwrappers invocan (correrlo a pelo NO es el flujo normal — pero como self-heal DIRECTO sí, ver GUPD).\nTambién es el manualUpdateHint que ofrece el widget."];
    GINST    [color="#7fb069",
              label="🟢  install-brain.sh (instalador INTERNO, invocado por los wrappers de arriba)\nHONRA CLAUDE_CONFIG_DIR (el override de Claude Code para ~/.claude): CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}\n→ hooks/skills/settings.json/.brain-version viven AHÍ, no hardcodeados a ~/.claude.\nDERIVA de brain/hooks/MANIFEST la lista {global} → copia hooks+libs a $CLAUDE_DIR/hooks,\ny de brain/skills/MANIFEST → copia skills a $CLAUDE_DIR/skills, cablea settings.json (incl. env defaults:\nOpus 4.8 + autocompact 70%) — el comando cableado usa $CLAUDE_CONFIG_DIR/hooks cuando el override está puesto\n(si no, $HOME/.claude/hooks), siembra dashboard + normas + entorno-maquina.md LEAN (@import en CLAUDE.md),\nDES-CABLA de settings.json cualquier hook marcado `retirado` en el MANIFEST (sin tocar entradas ajenas),\nsetea git config --global fetch.prune, y ESTAMPA $CLAUDE_DIR/.brain-version (sello de versión, lo lee el widget).\nlo envuelven wrappers GEMELOS por OS: ./install.sh (Linux/KDE: +daemon systemd+plasmoide)\ny macos/install.sh (macOS: +daemon launchd+.app, baja el precompilado o compila fallback).\nrequiere jq: SIN jq no cablea settings.json y los guards quedan fail-open (no bloquean)"];
    GUPD     [color="#7fb069",
              label="🟢  self-heal LOCAL: re-correr install-brain.sh DIRECTO (`bash ~/.cortex/brain/install-brain.sh`, sin pasar por bootstrap/widget)\nidempotente: refresca hooks, re-cablea, REEMPLAZA el bloque de normas en su lugar,\nre-estampa .brain-version — pero NO hace git fetch/pull (rev-list = lectura, sello de\nversión; `git config --global fetch.prune true` = write idempotente a ~/.gitconfig):\nre-aplica el clon TAL COMO ESTÁ, NO trae commits nuevos. ⚠️ Dispara 🟠 no-bypass-deploy\n(avisa, no bloquea). Legítimo solo si el clon ya está al día o eres tú quien desarrolla\nen el clon (equivalente al botón «Curar cerebro global» del widget); para traer versión\nNUEVA usa bootstrap.sh (GBOOT) o el ⬆ del widget (WID) — no este atajo"];
    GLIVE    [color="#7fb069", label="🟢  cerebro GLOBAL vivo en la máquina\n(aplica a TODOS los repos)"];
    GWIRE    [color="#7fb069",
              label="🟢  install-brain DERIVA la COPIA *y* el CABLEADO del MANIFEST (ev_de + loop),\nno una lista register_hook hardcodeada → agregar un hook global al MANIFEST lo copia\nY lo cablea. test-brain e6b FALLA si el set PreToolUse/Bash diverge del esperado."];

    // ── Ruta B: POR-REPO = SOLO la memoria + skills del proyecto (los guards vienen del install GLOBAL) ──
    RTIPO    [shape=diamond, fillcolor="#2b2622", color="#d97757", label="POR-REPO:\n¿repo nuevo, existente, o con cerebro por-repo VIEJO?"];
    CLON     [color="#7fb069",
              label="🟢  repo NUEVO: su .claude/ trae por git la MEMORIA del proyecto + sus skills propias.\nLos guards (hooks/libs) NO viajan por-repo — vienen del install GLOBAL de esta máquina\n(el cerebro vive solo en global). El repo-compartido marca sigue existiendo, pero para el\ngate de merge-develop-guard (ver 06), no para propagar el cerebro."];
    APLICA   [color="#9e9e9e", style="rounded,filled,dashed",
              label="🚧  repo EXISTENTE sin cerebro: sembrar .claude/ (memoria + skills) sigue siendo MANUAL.\naplicar-plantilla-a-proyecto es un playbook de UI/arquitectura que ASUME el cerebro ya presente."];
    BOOT     [color="#e08e45",
              label="🟠  bootstrap-claude.sh  (UNA vez tras clonar — script one-shot, NO un hook)\nsymlinkea la memoria + siembra dashboard + norma doc=realidad + verifica jq"];

    // ── Ruta C: MIGRACIÓN «solo cerebro global» + drift de la copia GLOBAL ──
    MIGRA    [color="#7fb069",
              label="🟢  MIGRACIÓN «solo cerebro global»: install-brain.sh --limpiar-repo <root> [--apply]\nretira de un repo que AÚN tiene el cerebro por-repo viejo: los hooks/libs del MANIFEST,\nel sello .brain-version, los artefactos RETIRED y las skills del cerebro (solo las del ledger\n.brain-skills o del MANIFEST, por CONTENIDO). DRY-RUN por default; --apply escribe con respaldo\nrecuperable en /tmp. La MEMORIA del proyecto y las skills propias del repo se conservan."];
    DRIFT    [color="#7fb069",
              label="🔔🧬  aviso-drift-cerebro.sh  (SessionStart · GLOBAL) — es también pieza de 02\navisa SOLO el drift de la copia GLOBAL del cerebro vs la fuente ~/.cortex, en tres frentes:\nhooks/libs (~/.claude/hooks), skills (~/.claude/skills) y el bloque de normas de ~/.claude/CLAUDE.md.\nSi una quedó atrás o se editó en vivo → avisa portar el cambio a la fuente + re-correr install-brain.\nWarn-only, throttle propio por frente. Ya NO chequea ni auto-sincroniza copias por-repo (se retiraron)."];

    // ── Ruta D: UPDATER del widget (⬆) ──
    WID      [color="#7fb069",
              label="🟢  widget (pestaña Cerebro, 3 GUIs): compara el SHA EMBEBIDO del build (version.json,\nque escribe make-app.sh) contra commits/main de github.com/unjordi/cortex (throttle ~15m, fail-open).\nSi el sha DIFIERE y es más nuevo → banner ⬆ Actualizar. (La píldora de salud muestra ~/.claude/.brain-version,\nsello APARTE que estampa install-brain.sh — no es lo que dispara el ⬆)"];
    WID_ACT  [color="#c0392b", penwidth=3,
              label="⚠ ESCRIBE git · 🟠  al aceptar ⬆: script DESPRENDIDO (nohup bash -lc) resuelve el clon local\n(resolveClonePath: embebido→$CLAUDE_BRAIN_DIR→~/.cortex→fallback ~/.claude-brain), lo MIGRA al nombre canónico si hace\nfalta, y hace git fetch + `checkout -B main origin/main` (FUERZA-alinea; descarta rama/commits leftover)\n→ re-corre macos/install.sh (macOS) / install.sh (Linux) (reconstruye+relanza). Fail-open: sin clon con\nmacos/install.sh → invita a actualizar a mano con el one-liner de bootstrap"];
    WID_ASSET [color="#c9a227",
              label="🟡  install.sh baja por DEFAULT el .app/.exe PRECOMPILADO del release rolling 'macos-latest'/\n'windows-latest' (release-macos.yml/release-windows.yml lo republica en CADA push a main, SIN filtro de\npaths → nunca rancio respecto al sha de main). Guard de staleness (#346): si el build-sha del asset ≠ HEAD\ndel clon y hay Xcode CLT → compila desde fuente en vez de instalar un asset rancio (antídoto al loop 'actualiza')"];
    WID_ATOM [color="#7fb069",
              label="🟢  atomicidad: install-brain instala los hooks con atomic_install (cp a tmp + mv,\nrename atómico) → el updater ⬆ ya no deja ventana de lectura a-medio-sobrescribir con sesión VIVA.\nRESUELTO (install-brain.sh atomic_install, en develop)"];

    NORMA    [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
              label="📜 → 🧩 toda norma nace con su mecanismo\n📜 → 🪞 doc = realidad (este mapa se actualiza con el código)"];

    // Aristas del flujo
    IN -> AMBITO;
    MANIF -> GINST [style=dashed, label="deriva {global}"];

    AMBITO -> GVEZ  [label="global"];
    AMBITO -> RTIPO [label="por-repo"];
    AMBITO -> WID   [label="updater ⬆"];

    GVEZ -> GBOOT [label="1ª vez (máquina fresca)\nO actualizar (bootstrap.sh idempotente)"];
    GBOOT -> GINST [label="despacha vía install.sh/macos install.sh"];
    GVEZ -> GUPD  [label="self-heal local\n(reparar clon actual, NO trae versión nueva)"];
    GINST -> GLIVE;
    GUPD  -> GLIVE;
    GINST -> GWIRE [style=dashed, label="cableado (deriva del MANIFEST)"];

    RTIPO -> CLON   [label="nuevo"];
    RTIPO -> APLICA [label="existente"];
    RTIPO -> MIGRA  [label="con cerebro por-repo viejo"];
    CLON  -> BOOT;
    APLICA -> BOOT;

    GLIVE -> DRIFT [label="al iniciar sesión\n(aviso-drift GLOBAL)"];
    BOOT  -> DRIFT [label="al iniciar sesión"];

    WID -> WID_ACT;
    WID_ACT -> WID_ASSET [label="reinstala"];
    WID_ASSET -> WID_ATOM;

    DRIFT -> NORMA    [style=dashed];
    MIGRA -> NORMA    [style=dashed];
    WID_ATOM -> NORMA [style=dashed];
    GWIRE -> NORMA    [style=dashed];
  }
}
