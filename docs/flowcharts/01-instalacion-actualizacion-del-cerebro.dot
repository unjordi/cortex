// 01 — Instalación / actualización del cerebro (claude-brain)  ·  FUENTE editable (Graphviz .dot)
// Render:  dot -Tsvg 01-instalacion-actualizacion-del-cerebro.dot -o 01-instalacion-actualizacion-del-cerebro.svg
// Rehecho 2026-07-29 contra el estado REAL del código (MANIFEST + install-brain.sh + sincronizar-cerebro.sh
// + aviso-drift-cerebro.sh + docs/autoupdate.md). Sustituye al 01 obsoleto que pintaba como "[futuro]/hueco"
// cosas que YA existen. Los 🔴 que quedan son huecos VIGENTES en develop (algunos atacados por el MR
// en vuelo fix/brain-drift-costura — aquí se dibuja el estado de develop, no el del MR).
digraph flujos {
  graph [bgcolor="#1b1712", rankdir=TB, fontname="Helvetica", splines=true,
         nodesep=0.35, ranksep=0.55, pad=0.25];
  node  [fontname="Helvetica", fontsize=12, fontcolor="#f2ede6", shape=box,
         style="rounded,filled", fillcolor="#2b2b2b", color="#8a8a8a", penwidth=1.5];
  edge  [color="#d97757", fontname="Helvetica", fontsize=10, fontcolor="#cfc8c0", penwidth=1.4];

  // ─────────────────────────── LEYENDA (regla dura del skill diagramar) ───────────────────────────
  subgraph cluster_leyenda {
    label="LEYENDA"; labeljust="l"; fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";
    LEY [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#5fa89e" bgcolor="#1b1712">
        <tr><td bgcolor="#232323"><font color="#cfc8c0">rectángulo redondo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">paso / estado</font></td></tr>
        <tr><td bgcolor="#2b2622"><font color="#f2ede6">rombo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">decisión (¿…?)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#7fb069"><font color="#f2ede6">🟢 verde</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">funciona / existe / OK</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#e08e45"><font color="#f2ede6">🟠 naranja</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">warning / paso manual / matiz</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c9a227"><font color="#f2ede6">🟡 dorado</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">drift LATENTE (hoy coincide, frágil)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c0392b"><font color="#f2ede6">🔴 rojo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">HUECO / bug VIGENTE</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#d97757">→ flecha</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">flujo; discontinua = "deriva de"</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#cfc8c0">🔔 hook</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">· 💾 skill · 📜 → norma · ⚠ ESCRIBE git</font></td></tr>
      </table>>];
  }

  // ───────────────────────────────────── EL PROCESO ─────────────────────────────────────
  subgraph cluster_f8 {
    label="⓪ Instalación / actualización del cerebro   (install-brain · sincronizar-cerebro · bootstrap-claude · aviso-drift · widget ⬆)";
    fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";

    IN       [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
              label="instalar o actualizar el cerebro\nen esta máquina / repo"];

    // MANIFEST como FUENTE ÚNICA — de aquí DERIVAN las dos rutas de despliegue.
    MANIF    [color="#7fb069",
              label="🟢  brain/hooks/MANIFEST = FUENTE ÚNICA\ndeclara por hook su TIER {global|repo|both} + KIND {hook|lib|script}.\nDe aquí DERIVAN las 2 rutas de despliegue y el drift-check de test-brain\n(antídoto a las 2 listas curadas por separado que divergían)"];

    AMBITO   [shape=diamond, fillcolor="#2b2622", color="#d97757", label="¿ámbito?"];

    // ── Ruta A: GLOBAL (máquina) = install-brain.sh ──
    GVEZ     [shape=diamond, fillcolor="#2b2622", color="#d97757", label="GLOBAL (máquina):\n¿1ª vez o actualizar?"];
    GINST    [color="#7fb069",
              label="🟢  install-brain.sh\nDERIVA del MANIFEST la lista {global,both} (:57) → copia hooks+libs a ~/.claude/hooks,\ncablea settings.json, siembra dashboard + entorno-esta-maquina + normas, y ESTAMPA\n~/.claude/.brain-version (sello de versión, :127-132 — YA EXISTE, lo lee el widget).\n(install.sh lo envuelve SOLO en Linux/KDE: +daemon+systemd+plasmoide)"];
    GUPD     [color="#e08e45",
              label="🟠  re-correr install-brain.sh\nidempotente Y ACTUALIZABLE: refresca hooks, re-cablea,\nREEMPLAZA el bloque de normas en su lugar, re-estampa .brain-version"];
    GLIVE    [color="#7fb069", label="🟢  cerebro GLOBAL vivo en la máquina\n(aplica a TODOS los repos)"];
    GWIRE    [color="#c9a227",
              label="🟡  drift LATENTE: install-brain DERIVA la COPIA del MANIFEST (:57)\npero CABLEA con register_hook HARDCODE (:90-109). Agregar un hook global al\nMANIFEST → se COPIA pero NO se cablea (queda .sh muerto). Contraste: sincronizar\nDERIVA copia Y wiring del MANIFEST. Hoy coinciden, pero frágil.\n→ derivar el wiring del MANIFEST, o que test-brain falle si divergen"];

    // ── Ruta B: POR-REPO (clon / repo consumidor) ──
    RTIPO    [shape=diamond, fillcolor="#2b2622", color="#d97757", label="POR-REPO:\n¿repo nuevo o existente?"];
    CLON     [color="#7fb069",
              label="🟢  repo NUEVO desde la plantilla\nel clon TRAE .claude/ (hooks+settings+skills+memoria) por git — el tooling VIAJA\nen el repo. secret-scan es tier `both` (:26 MANIFEST) → viaja por-repo y YA está\ncableado (el viejo 🔴 «clon+bootstrap no da secret-scan» está RESUELTO)"];
    APLICA   [color="#e08e45",
              label="🟠  repo EXISTENTE: sembrar .claude/ sigue siendo MANUAL (no scriptado).\naplicar-plantilla-a-proyecto NO copia .claude/ — es un playbook de UI/arquitectura\nque ASUME el cerebro ya presente (hueco moderado, aún vigente)"];
    BOOT     [color="#e08e45",
              label="🔔  bootstrap-claude.sh  (UNA vez tras clonar)\nsymlinkea la memoria + siembra dashboard + norma doc=realidad + verifica jq"];
    BOOT_INV [color="#c0392b",
              label="🔴  DRIFT INVERSO (vigente en repos consumidores): el bootstrap-claude.sh de la\nplantilla hace `cp -f` INCONDICIONAL de solo 3 de los 6 `both` (git-branch-guard,\nmerge-squash-guard, recordar-dashboard) → un clon con plantilla VIEJA PISA los\nglobales con versiones stale y quedó corto vs el MANIFEST actual (6 both).\n→ que el bootstrap invoque sincronizar/install-brain derivando del MANIFEST"];

    // ── Ruta C: ACTUALIZAR una copia POR-REPO ya instalada (esto era el viejo 🔴 HUECO — hoy RESUELTO) ──
    CUPD     [shape=diamond, fillcolor="#2b2622", color="#d97757",
              label="el brain EVOLUCIONÓ: ¿cómo se actualizan\nlos .claude/ de un repo YA instalado?"];
    SYNC     [color="#7fb069",
              label="🟢  sincronizar-cerebro.sh  (YA EXISTE, resuelve el viejo HUECO)\nFUENTE ÚNICA = MANIFEST; despliega por-repo {repo,both}, diff-aware (NO cp -f ciego),\nCABLEA settings.json, ESTAMPA .brain-version (solo en sync COMPLETO), PODA hooks\nRETIRED. DRY-RUN por default; --apply escribe; --only / --prune-orphans"];
    DRIFT    [color="#7fb069",
              label="🟢🔔  aviso-drift-cerebro.sh  (SessionStart · GLOBAL) — es también pieza de 02\ncorre sincronizar en DRY-RUN (diff por CONTENIDO); si la copia por-repo quedó atrás → AVISA.\n⚠ AUTO-APPLY en mini-develop: en rama Develop* con .claude/ limpio → apply+commit+push SOLO\n📜 → 🌿 Flujo de git (en repo compartido «actualizar» = por ramita→MR)"];
    DRIFT_CIEGO [color="#c0392b",
              label="🔴  aviso-drift es CIEGO al drift de CABLEADO: cuenta nuevos+actualizar+retirado,\nNUNCA el wiring FALTANTE → reporta «al día» aunque haya hooks presentes-SIN-cablear\n(comprobado en la plantilla: 3 sin cablear; 2 recordar-* muertos).\n[atacado por el MR en vuelo fix/brain-drift-costura — aquí: estado de develop]"];
    DRIFT_STAGE [color="#c0392b",
              label="🔴  el AUTO-APPLY hace `git add .claude/hooks` pero sincronizar --apply también\nreescribe settings.json → ese cambio queda SIN commitear (ensucia el árbol,\ncontra su propio contrato). → `git add .claude/hooks .claude/settings.json`\n[también en el MR en vuelo fix/brain-drift-costura]"];

    // ── Ruta D: UPDATER del widget (⬆) ──
    WID      [color="#7fb069",
              label="🟢  widget (pestaña Cerebro, 3 GUIs): lee ~/.claude/.brain-version y consulta\ncommits/main de github.com/unjordi/claude-brain (throttle ~15m, fail-open).\nSi main avanzó → dibuja el banner ⬆ Actualizar"];
    WID_ACT  [color="#e08e45",
              label="🟠  al aceptar ⬆: script suelto hace git fetch + merge --ff-only origin/main sobre\n~/.claude-brain y —solo si tuvo éxito— re-corre install.sh/ps1 (reconstruye+relanza,\ndesprendido). Fase 2 Windows: baja el .exe del release (pendiente de QA)"];
    WID_ATOM [color="#c0392b",
              label="🔴  atomicidad: el updater reescribe ~/.claude-brain / ~/.claude/hooks con `cp -f`\naunque haya sesión VIVA → un hook que sourcea una lib puede leerla a medio sobrescribir.\nSin escritura atómica (cp a tmp + mv) ni lock. (inferido, no ejecutado)"];

    NORMA    [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
              label="📜 → 🧩 toda norma nace con su mecanismo\n📜 → 🪞 doc = realidad (este mapa se actualiza con el código)"];

    // Aristas del flujo
    IN -> AMBITO;
    MANIF -> GINST [style=dashed, label="deriva {global,both}"];
    MANIF -> SYNC  [style=dashed, label="deriva {repo,both}"];

    AMBITO -> GVEZ  [label="global"];
    AMBITO -> RTIPO [label="por-repo"];
    AMBITO -> WID   [label="updater ⬆"];

    GVEZ -> GINST [label="1ª vez"];
    GVEZ -> GUPD  [label="actualizar"];
    GINST -> GLIVE;
    GUPD  -> GLIVE;
    GINST -> GWIRE [style=dashed, label="wiring hardcode"];

    RTIPO -> CLON   [label="nuevo"];
    RTIPO -> APLICA [label="existente"];
    CLON  -> BOOT;
    APLICA -> BOOT;
    BOOT -> BOOT_INV;

    GLIVE -> CUPD [label="con el tiempo…"];
    BOOT  -> CUPD [label="con el tiempo…"];
    CUPD -> SYNC  [label="a mano / CI"];
    CUPD -> DRIFT [label="al iniciar sesión"];
    SYNC -> DRIFT_CIEGO [style=dashed];
    DRIFT -> DRIFT_CIEGO;
    DRIFT -> DRIFT_STAGE;

    WID -> WID_ACT;
    WID_ACT -> WID_ATOM;

    DRIFT_CIEGO -> NORMA [style=dashed];
    BOOT_INV -> NORMA    [style=dashed];
    WID_ATOM -> NORMA    [style=dashed];
    GWIRE -> NORMA       [style=dashed];
  }
}
