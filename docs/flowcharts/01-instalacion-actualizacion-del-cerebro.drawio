<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="LEYENDA — árbol completo del cerebro (fuente: README.md)" style="rounded=1;arcSize=4;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=none;strokeColor=#5fa89e;strokeWidth=1.6;fontColor=#5fa89e;fontFamily=Times;fontSize=14;" vertex="1" parent="1"><mxGeometry x="8.0" y="8.0" width="3194.0" height="1474.4" as="geometry"/></mxCell><mxCell id="n1" value="01 · Instalación / actualización del cerebro   (bootstrap.sh · install-brain · sincronizar-cerebro · bootstrap-claude · aviso-drift · widget ⬆)" style="rounded=1;arcSize=4;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=none;strokeColor=#5fa89e;strokeWidth=1.6;fontColor=#5fa89e;fontFamily=Times;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3210.0" y="593.6" width="2457.0" height="2436.6" as="geometry"/></mxCell><mxCell id="n2" value="
      &lt;table border=&quot;0&quot; cellborder=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; color=&quot;#5fa89e&quot; bgcolor=&quot;#1b1712&quot;&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;🔒 Hooks Forzosos&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔗 merge-develop-guard&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;push directo a develop·main, o MR sin --squash/sin tu OK → denegado; a main exige OK súper-explícito&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💸 delegacion-gate&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;delegar al llegar al 90% de tu ventana 5h → pide tu OK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛑 limite-gasto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;sin ventana 5h Y sin overage (ambos agotados) → freno duro&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;🔔 Automático&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🖥️ entorno-maquina-guard&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;commit de algo machine-specific (aliases/rutas de $HOME/Rosetta/entorno-maquina.md) al .claude/memory/ del repo → avisa&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚧 no-bypass-deploy&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;correr el instalador/deploy a mano (install-brain.sh/deploy.sh, helm/kubectl apply -f, aun tras sudo/nohup/VAR=/source) en vez de la herramienta oficial (el widget) → avisa (fail-safe: no --dry-run/--help/CI)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌳 proteger-arbol&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;git destructivo que orfanaría commits sin pushear → avisa (fan-out: usa worktree aislado)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛡️ proteger-fuente-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;editar la copia INSTALADA de un hook/skill que tiene fuente en el clon → avisa (se perdería en el próximo sync); + un Edit a settings.json que decablea un hook del cerebro o agrega un escape de guard → avisa (tu propio candado) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧹 barrer-ramas&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;al abrir sesión / al punto del merge barre en 2º plano ramas locales + remota huérfana + worktrees ya integrados (zombie squash-safe; throttle 24h) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💾 exportar-sesion-master&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;auto-export de las sesiones *-master a ~/.claude-sessions (o Drive); detached, sobrevive el cleanup de 30 días (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗂️ checkpoint-mecanico&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;PreCompact: extractor mecánico (streaming, 0 tokens) escribe el andamio del TRAMO VIVO a hilo-mental-actual.andamio.md (GLOBAL; el skill lo regenera con --self --ensure)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📝 delegacion-registrar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;materializa el &quot;pregunta una sola vez&quot;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧵 rehidratar-hilo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reinyecta hilo-mental-actual.md + el andamio (si es más fresco) al abrir/retomar/compactar (GLOBAL) — gate de frescura + edad&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📈 aviso-contexto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;al umbral ALTO del punto REAL de compact (80%/92% de autoCompactWindow o la ventana efectiva; % honesto, respeta autoCompactEnabled): VUELCA el checkpoint mecánico solito y ORDENA /checkpoint+/compact. No gotea (silencio bajo el umbral, 1 disparo + 1 escalada) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧬 aviso-drift-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;la copia GLOBAL del cerebro (hooks/libs/skills + el bloque de normas de ~/.claude/CLAUDE.md) quedó atrás de la fuente o se editó en vivo → aviso (warn-only, throttle propio por frente). El cerebro ya no viaja por-repo (solo global). Al moverse el cerebro, NUDGE a correr la DUPLA (suficiencia+coherencia; contra la firma si hay AGENTS.md, si no sugiere instanciarla) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧭 sesion-inicio&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reinyecta rama + norma + memoria al abrir (BOTH)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌾 recordar-cosechar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;espejo automático del TaskList vivo → bloque fenced en estado-proyecto.md (determinista, sin LLM) (BOTH)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;📜 Normas&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🎯 Definition of Done&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;verde técnico ≠ Done/Listo/Ya Quedó; exige QA o un OK explícito&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🪞 Doc &amp;lt;= realidad&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;cambió algo → su doc se actualiza en la tanda&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌿 Flujo de git&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ramita → MR → develop; main es release-only&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💰 Costo de delegación&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;gratis / incluido / con costo, según tu cuota&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;💡 Skills&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📦 cerrar-slice&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;build+tests+memoria al día + MR con resumen curado&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💾 checkpoint&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;vuelca el HILO a memoria para compactar sin perderlo (proactivo)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗂️ to-do&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;carga la interfaz de tareas del harness desde el backlog durable (estado-proyecto.md)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💧 rehidratar-hilo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;relee el HILO a mano (gemelo del hook; respaldo si un update del CLI rompe el auto-rehidratado)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛟 reconstruir-contexto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;RED DE EMERGENCIA cuando el checkpoint quedó pobre y /compact fundió el hilo: excava andamio→backlog→transcript y cierra re-volcando con checkpoint&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗺️ diagramar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;diagramas por destino: draw.io por defecto (skill oficial drawio) · Mermaid en .md versionado (verse en GitHub)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔬 auditar-proceso-algoritmo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;auditor experto read-only (proceso industrial + algoritmo) → hallazgos priorizados; se alimenta de los flowcharts de diagramar&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🩺 auditar-coherencia-cerebro fan-out read-only sobre el PROPIO cerebro (guards+flowcharts+doc): evasiones/huecos/drift, verificado por ejecución → loop hasta converger; modo-cerebro de auditar-proceso-algoritmo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt; &lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧪 auditar-suficiencia-operativa&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;¿ALCANZA la doc para HACER el trabajo sin romper nada ni re-investigar? tareas reales ✅/⚠️/❌ con archivo:línea + RE-auditar tras arreglar&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧬 auditor-semantico&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;¿el código HACE lo que queremos? Capa 1 checks deterministas (scripts/, gratis, en CI) + Capa 2 criterio LLM sobre invariantes-semanticos.yml; motor genérico, catálogo por-repo&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📐 canonizar-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;DUEÑO del ciclo de vida del cerebro de un proyecto, 4 modos sobre 1 maquinaria: sembrar (nace nativo, sin symlinks) · canonizar (firma-árbol: git mv a dom-/dev-/ux-/qa-, verifica 1:1 con verificar-firma-canonica.sh) · consolidar (dupla → positivar → desinflar → convergencia → FIRMA) · reconciliar (semanal, minis de devs → develop)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🪶 desinflar-memorias&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;adelgaza un árbol de memorias sin perder lecciones: la narrativa se colapsa a su lección, los mitos descartados se mudan al cementerio.md (una lápida por ID content-hash 🪦#&amp;lt;id&amp;gt;)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;☀️ positivar-doc&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reescribe answer-first: &#x27;ESTO SÍ&#x27; (método correcto) antes del &#x27;ESTO NO&#x27;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🎓 investigar-dominio&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ponte experto en un dominio (fan-out DOC-FIRST) → memorias durables + skills&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📚 construir-missing-manual&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;fabrica el manual/wiki de referencia exhaustivo que no existe (fan-out que investiga 1× y hornea) → artefacto consultable OFFLINE&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚚 reubicar-master&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;muda una sesión master COMPLETA a otro repo (brain-master → cortex) sin residuo: transcript+cwd, cerebro, slug y refs atómicas&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛰️ coordinar-claudes&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;coordina otros masters en nombre del usuario: despierta (desde los transcripts, no masters.json) · encarga la cola · vigila (commit/colgado/muerto) · destraba · verifica con evidencia · releva OKs del usuario&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔍 zoom-screenshot&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;recorta y amplía regiones de una captura (ffmpeg) para leer texto fino ilegible&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔩 ingenieria-inversa-gui-db-navegador&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ingeniería inversa de app legacy GUI+BD: driving la UI vía navegador + diff de la BD antes/después = doc con evidencia real&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📕 markdown-a-pdf&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;convierte .md a PDF pulido y distribuible vía md-to-pdf (npx, sin instalar) con el gotcha de --css y QA visual real&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🕹️ control-gui-remota-por-ssh&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ver/operar una GUI remota por SSH sin VNC/RDP — screenshot/click/teclado DPI-aware; Windows·Linux·Mac completos (multi-monitor + captura por-ventana)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔁 mandato-loop&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;el MOLDE para redactar un mandato de `/loop` de épica/lote (cómo se redacta + el bloque text con todas sus secciones)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌙 turno-nocturno&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;protocolo del turno de noche: eco del contrato, decide-dentro-de-la-cerca, grants durables a disco&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
      &lt;/table&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#8a8a8a;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n0"><mxGeometry x="7.9" y="31.0" width="3178.2" height="1210.2" as="geometry"/></mxCell><mxCell id="n3" value="
      &lt;table border=&quot;0&quot; cellborder=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; color=&quot;#5fa89e&quot; bgcolor=&quot;#1b1712&quot;&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;valencia de color&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#7fb069&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟢&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;OK / pasa&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#e08e45&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟠&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;aviso / ASK (no bloquea)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#c9a227&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟡&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;latente / frágil (funciona hoy, sin garantía)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#c0392b&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔴&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;DENY / bloqueo (guard OK)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#9e9e9e&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚧&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;hueco / deuda (por construir)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;⚠&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;el paso ESCRIBE git&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
      &lt;/table&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#8a8a8a;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n0"><mxGeometry x="1471.2" y="1282.2" width="251.5" height="184.2" as="geometry"/></mxCell><mxCell id="n4" value="instalar o actualizar el cerebro&lt;br&gt;en esta máquina / repo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#232323;strokeColor=#8a8a8a;strokeWidth=1.5;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="465.1" y="32.5" width="175.8" height="36.0" as="geometry"/></mxCell><mxCell id="n5" value="🟢  brain/hooks/MANIFEST = FUENTE ÚNICA&lt;br&gt;declara por hook su TIER {global|repo|both} + KIND {hook|lib|script}.&lt;br&gt;De aquí DERIVAN las 2 rutas de despliegue y el drift-check de test-brain&lt;br&gt;(antídoto a las 2 listas curadas por separado que divergían)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1306.4" y="1101.7" width="399.2" height="62.0" as="geometry"/></mxCell><mxCell id="n6" value="¿ámbito?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="495.7" y="770.7" width="114.7" height="36.0" as="geometry"/></mxCell><mxCell id="n7" value="GLOBAL (máquina):&lt;br&gt;¿1ª vez, actualizar, o self-heal?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="370.5" y="932.9" width="365.0" height="67.0" as="geometry"/></mxCell><mxCell id="n8" value="⚠ ESCRIBE git · 🟢  bootstrap.sh — ENTRADA REAL en máquina fresca Y VÍA OFICIAL&lt;br&gt;para ACTUALIZAR (bootstrap.sh:9 &amp;#x27;Idempotente: re-correrlo solo actualiza&amp;#x27;)&lt;br&gt;(curl -fsSL …/bootstrap.sh | bash): instala prereqs con el gestor del OS (git/jq/node;&lt;br&gt;en macOS exige brew+Xcode CLT) + clona o `git checkout -B main origin/main` para&lt;br&gt;ALINEAR el clon a origin/main en ~/.cortex (fuerza-alinea, descarta rama/commits&lt;br&gt;leftover — mismo comando que WID_ACT; `CLAUDE_BRAIN_REF=&amp;lt;rama&amp;gt;` instala otra rama, p. ej. develop en QA) + `mv`/`git remote set-url` si migra clones&lt;br&gt;viejos claude-brain→cortex + despacha a ./install.sh (Linux/KDE) o macos/install.sh&lt;br&gt;(macOS) — en el flujo de bootstrap, install-brain.sh es el instalador INTERNO que esos&lt;br&gt;wrappers invocan (correrlo a pelo NO es el flujo normal — pero como self-heal DIRECTO sí, ver GUPD).&lt;br&gt;También es el manualUpdateHint que ofrece el widget." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#c0392b;strokeWidth=3;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="426.4" y="1062.3" width="855.2" height="140.8" as="geometry"/></mxCell><mxCell id="n9" value="🟢  install-brain.sh (instalador INTERNO, invocado por los wrappers de arriba)&lt;br&gt;HONRA CLAUDE_CONFIG_DIR (el override de Claude Code para ~/.claude): CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}&lt;br&gt;→ hooks/skills/settings.json/.brain-version viven AHÍ, no hardcodeados a ~/.claude.&lt;br&gt;DERIVA de brain/hooks/MANIFEST la lista {global,both} → copia hooks+libs a $CLAUDE_DIR/hooks,&lt;br&gt;y de brain/skills/MANIFEST → copia skills a $CLAUDE_DIR/skills, cablea settings.json (incl. env defaults:&lt;br&gt;Opus 4.8 + autocompact 70%) — el comando cableado usa $CLAUDE_CONFIG_DIR/hooks cuando el override está puesto&lt;br&gt;(si no, $HOME/.claude/hooks), siembra dashboard + normas + entorno-maquina.md LEAN (@import en CLAUDE.md),&lt;br&gt;genera aliases-activos.md (@import en CLAUDE.md), setea git config --global fetch.prune,&lt;br&gt;y ESTAMPA $CLAUDE_DIR/.brain-version (sello de versión — YA EXISTE, lo lee el widget).&lt;br&gt;lo envuelven wrappers GEMELOS por OS: ./install.sh (Linux/KDE: +daemon systemd+plasmoide)&lt;br&gt;y macos/install.sh (macOS: +daemon launchd+.app, baja el precompilado o compila fallback).&lt;br&gt;requiere jq: SIN jq no cablea settings.json y los guards quedan fail-open (no bloquean)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1027.1" y="1360.6" width="757.7" height="170.7" as="geometry"/></mxCell><mxCell id="n10" value="🟢  self-heal LOCAL: re-correr install-brain.sh DIRECTO (`bash ~/.cortex/brain/install-brain.sh`, sin pasar por bootstrap/widget)&lt;br&gt;idempotente: refresca hooks, re-cablea, REEMPLAZA el bloque de normas en su lugar,&lt;br&gt;re-estampa .brain-version — pero NO hace git fetch/pull (rev-list = lectura, sello de&lt;br&gt;versión; `git config --global fetch.prune true` = write idempotente a ~/.gitconfig):&lt;br&gt;re-aplica el clon TAL COMO ESTÁ, NO trae commits nuevos. ⚠️ Dispara 🟠 no-bypass-deploy&lt;br&gt;(avisa, no bloquea). Legítimo solo si el clon ya está al día o eres tú quien desarrolla&lt;br&gt;en el clon (equivalente al botón «Curar cerebro global» del widget); para traer versión&lt;br&gt;NUEVA usa bootstrap.sh (GBOOT) o el ⬆ del widget (WID) — no este atajo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="481.4" y="1223.1" width="681.2" height="117.5" as="geometry"/></mxCell><mxCell id="n11" value="🟢  cerebro GLOBAL vivo en la máquina&lt;br&gt;(aplica a TODOS los repos)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="999.5" y="1572.4" width="229.0" height="36.5" as="geometry"/></mxCell><mxCell id="n12" value="🟢  install-brain ahora DERIVA la COPIA *y* el CABLEADO del MANIFEST (ev_de + loop),&lt;br&gt;no una lista register_hook hardcodeada → agregar un hook global al MANIFEST lo copia&lt;br&gt;Y lo cablea. test-brain e6b FALLA si el set PreToolUse/Bash diverge del esperado.&lt;br&gt;RESUELTO (refactor MANIFEST-derivado + e6b, en develop 2026-07-30)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1816.6" y="1787.4" width="496.7" height="64.2" as="geometry"/></mxCell><mxCell id="n13" value="POR-REPO:&lt;br&gt;¿repo nuevo o existente?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="72.0" y="1099.2" width="302.0" height="67.0" as="geometry"/></mxCell><mxCell id="n14" value="🟢  repo NUEVO desde la plantilla&lt;br&gt;el clon TRAE .claude/ (hooks+settings+skills+memoria) por git — el tooling VIAJA&lt;br&gt;en el repo. Los hooks tier `both` (declarados en el MANIFEST) viajan por-repo y YA están&lt;br&gt;cableados" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="8.4" y="1415.0" width="489.2" height="62.0" as="geometry"/></mxCell><mxCell id="n15" value="🚧  repo EXISTENTE: sembrar .claude/ sigue siendo MANUAL (no scriptado).&lt;br&gt;aplicar-plantilla-a-proyecto NO copia .claude/ — es un playbook de UI/arquitectura&lt;br&gt;que ASUME el cerebro ya presente (hueco moderado, aún vigente)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;dashed=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="522.8" y="1421.4" width="452.5" height="49.3" as="geometry"/></mxCell><mxCell id="n16" value="🟠  bootstrap-claude.sh  (UNA vez tras clonar — script one-shot, NO un hook)&lt;br&gt;symlinkea la memoria + siembra dashboard + norma doc=realidad + verifica jq" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#e08e45;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="533.6" y="1572.4" width="430.7" height="36.5" as="geometry"/></mxCell><mxCell id="n17" value="🚧  DRIFT INVERSO (vigente en repos CONSUMIDORES, fuera de cortex): el&lt;br&gt;bootstrap-claude.sh de la plantilla hace `cp -f` INCONDICIONAL de solo 3 de los 6 `both`&lt;br&gt;→ un clon con plantilla VIEJA PISA los globales con versiones stale (corto vs el MANIFEST).&lt;br&gt;→ que el bootstrap invoque install-brain (que YA deriva del MANIFEST). Pendiente en la plantilla." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;dashed=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="481.9" y="1997.1" width="534.2" height="66.5" as="geometry"/></mxCell><mxCell id="n18" value="el brain EVOLUCIONÓ: ¿cómo se actualizan&lt;br&gt;los .claude/ de un repo YA instalado?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="858.7" y="1700.3" width="510.5" height="67.0" as="geometry"/></mxCell><mxCell id="n19" value="🟢  sincronizar-cerebro.sh  (YA EXISTE, resuelve el viejo HUECO)&lt;br&gt;FUENTE ÚNICA = MANIFEST; despliega por-repo {repo,both}, diff-aware (NO cp -f ciego),&lt;br&gt;CABLEA settings.json, ESTAMPA .brain-version (solo en sync COMPLETO), PODA hooks&lt;br&gt;RETIRED. DRY-RUN por default; --apply escribe; --only / --prune-orphans" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1554.7" y="1893.4" width="494.5" height="62.0" as="geometry"/></mxCell><mxCell id="n20" value="🔔🧬  aviso-drift-cerebro.sh  (SessionStart · GLOBAL) — es también pieza de 02&lt;br&gt;corre sincronizar en DRY-RUN (diff por CONTENIDO); si la copia por-repo quedó atrás →&lt;br&gt;BIFURCA por la marca .claude/repo-compartido (REDISEÑO #46, ver drift_chequea_repo)&lt;br&gt;TAMBIÉN en CADA SessionStart (ANTES del throttle per-repo): reinyecta&lt;br&gt;conocimiento-propio.md (identidad del repo, imborrable) + avisa drift de la copia&lt;br&gt;GLOBAL de skills (~/.claude/skills vs fuente; warn-only, throttle propio) (ver 02)&lt;br&gt;📜 → 🌿 Flujo de git (en repo compartido «actualizar» = por ramita→MR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="865.6" y="1871.6" width="496.7" height="105.5" as="geometry"/></mxCell><mxCell id="n21" value="¿.claude/repo-compartido&lt;br&gt;(la marca)?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="961.5" y="2083.6" width="305.0" height="67.0" as="geometry"/></mxCell><mxCell id="n22" value="⚠ ESCRIBE git · 🟢  COMPARTIDO (con la marca): el brain por-repo es CORREO para clones/colegas&lt;br&gt;SIN brain global → en mini-develop (Develop*) con .claude/ limpio: apply+commit+push SOLO;&lt;br&gt;si no aplica limpio, AVISA para propagar por ramita→MR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#c0392b;strokeWidth=3;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="775.0" y="2201.8" width="562.0" height="53.8" as="geometry"/></mxCell><mxCell id="n23" value="🟢  PERSONAL (DEFAULT, sin la marca): guards por-repo NUNCA hacen falta&lt;br&gt;(esta máquina ya los saca del install GLOBAL + dedupe) → NO auto-commit/push;&lt;br&gt;FLAGGEA los guards del brain que SOBRAN para que los quites. Memoria/skills intactos." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1361.9" y="2203.0" width="492.2" height="51.5" as="geometry"/></mxCell><mxCell id="n24" value="🟢  aviso-drift YA VE el drift de CABLEADO: cuenta también el wiring FALTANTE&lt;br&gt;(«N cableado faltante») → ya no reporta «al día» con hooks presentes-SIN-cablear.&lt;br&gt;RESUELTO en #209 (en develop, 2026-07-30)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1591.1" y="2296.6" width="457.7" height="51.5" as="geometry"/></mxCell><mxCell id="n25" value="🟢  el AUTO-APPLY ahora hace `git add -A .claude/` (hooks + settings.json + podas)&lt;br&gt;→ el cambio de cableado SÍ se commitea y el árbol queda limpio.&lt;br&gt;RESUELTO en #209 (en develop, 2026-07-30)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="826.7" y="2296.6" width="458.5" height="51.5" as="geometry"/></mxCell><mxCell id="n26" value="🟢  widget (pestaña Cerebro, 3 GUIs): compara el SHA EMBEBIDO del build (version.json,&lt;br&gt;que escribe make-app.sh) contra commits/main de github.com/unjordi/cortex (throttle ~15m, fail-open).&lt;br&gt;Si el sha DIFIERE y es más nuevo → banner ⬆ Actualizar. (La píldora de salud muestra ~/.claude/.brain-version,&lt;br&gt;sello APARTE que estampa install-brain.sh — no es lo que dispara el ⬆)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="773.1" y="933.5" width="613.7" height="65.7" as="geometry"/></mxCell><mxCell id="n27" value="⚠ ESCRIBE git · 🟠  al aceptar ⬆: script DESPRENDIDO (nohup bash -lc) resuelve el clon local&lt;br&gt;(resolveClonePath: embebido→$CLAUDE_BRAIN_DIR→~/.cortex→fallback ~/.claude-brain), lo MIGRA al nombre canónico si hace&lt;br&gt;falta, y hace git fetch + `checkout -B main origin/main` (FUERZA-alinea; descarta rama/commits leftover)&lt;br&gt;→ re-corre macos/install.sh (macOS) / install.sh (Linux) (reconstruye+relanza). Fail-open: sin clon con&lt;br&gt;macos/install.sh → invita a actualizar a mano con el one-liner de bootstrap" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#c0392b;strokeWidth=3;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1730.6" y="1092.0" width="718.7" height="81.5" as="geometry"/></mxCell><mxCell id="n28" value="🟡  install.sh baja por DEFAULT el .app/.exe PRECOMPILADO del release rolling &amp;#x27;macos-latest&amp;#x27;/&lt;br&gt;&amp;#x27;windows-latest&amp;#x27; (release-macos.yml/release-windows.yml lo republica en CADA push a main, SIN filtro de&lt;br&gt;paths → nunca rancio respecto al sha de main). Guard de staleness (#346): si el build-sha del asset ≠ HEAD&lt;br&gt;del clon y hay Xcode CLT → compila desde fuente en vez de instalar un asset rancio (antídoto al loop &amp;#x27;actualiza&amp;#x27;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#c9a227;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1836.9" y="1412.7" width="612.3" height="66.5" as="geometry"/></mxCell><mxCell id="n29" value="🟢  atomicidad: install-brain instala los hooks con atomic_install (cp a tmp + mv,&lt;br&gt;rename atómico) → el updater ⬆ ya no deja ventana de lectura a-medio-sobrescribir con sesión VIVA.&lt;br&gt;RESUELTO (install-brain.sh atomic_install, en develop)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2b2b;strokeColor=#7fb069;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1878.6" y="1628.8" width="556.7" height="51.5" as="geometry"/></mxCell><mxCell id="n30" value="📜 → 🧩 toda norma nace con su mecanismo&lt;br&gt;📜 → 🪞 doc = realidad (este mapa se actualiza con el código)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#232323;strokeColor=#8a8a8a;strokeWidth=1.5;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="1775.4" y="2389.1" width="345.2" height="39.5" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="deriva {global,both}" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"><A