<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="LEYENDA — árbol completo del cerebro (fuente: README.md)" style="rounded=1;arcSize=4;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=none;strokeColor=#5fa89e;strokeWidth=1.6;fontColor=#5fa89e;fontFamily=Times;fontSize=14;" vertex="1" parent="1"><mxGeometry x="8.0" y="8.0" width="3194.0" height="1480.8" as="geometry"/></mxCell><mxCell id="n1" value="13 · Normas: el cimiento   (el porqué; cada flujo de los charts anteriores las hace cumplir)&lt;br&gt;subconjunto CURADO, no el set completo — todas las normas duras: brain/norms/global-claude-md.md" style="rounded=1;arcSize=4;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=none;strokeColor=#5fa89e;strokeWidth=1.6;fontColor=#5fa89e;fontFamily=Times;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3215.0" y="560.8" width="994.0" height="2119.0" as="geometry"/></mxCell><mxCell id="n2" value="
      &lt;table border=&quot;0&quot; cellborder=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; color=&quot;#5fa89e&quot; bgcolor=&quot;#1b1712&quot;&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;🔒 Hooks Forzosos&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔗 merge-develop-guard&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;push directo a develop·main, o MR sin --squash/sin tu OK → denegado; a main exige OK súper-explícito&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💸 delegacion-gate&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;delegar al llegar al 90% de tu ventana 5h → pide tu OK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛑 limite-gasto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;sin ventana 5h Y sin overage (ambos agotados) → freno duro&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;🔔 Automático&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🖥️ entorno-maquina-guard&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;commit de algo machine-specific (aliases/rutas de $HOME/Rosetta/entorno-maquina.md) al .claude/memory/ del repo → avisa&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚧 no-bypass-deploy&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;correr el instalador/deploy a mano (install-brain.sh/deploy.sh, helm/kubectl apply -f, aun tras sudo/nohup/VAR=/source) en vez de la herramienta oficial (el widget) → avisa (fail-safe: no --dry-run/--help/CI)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌳 proteger-arbol&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;git destructivo que orfanaría commits sin pushear → avisa (fan-out: usa worktree aislado)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛡️ proteger-fuente-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;editar la copia INSTALADA de un hook/skill que tiene fuente en el clon → avisa (se perdería en el próximo sync); + un Edit a settings.json que decablea un hook del cerebro o agrega un escape de guard → avisa (tu propio candado) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧹 barrer-ramas&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;al abrir sesión / al punto del merge barre en 2º plano ramas locales + remota huérfana + worktrees ya integrados (zombie squash-safe; throttle 24h) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💾 exportar-sesion-master&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;auto-export de las sesiones *-master a ~/.claude-sessions (o Drive); detached, sobrevive el cleanup de 30 días (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗂️ checkpoint-mecanico&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;PreCompact: extractor mecánico (streaming, 0 tokens) escribe el andamio del TRAMO VIVO a hilo-mental-actual.andamio.md (GLOBAL; el skill lo regenera con --self --ensure)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📝 delegacion-registrar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;materializa el &quot;pregunta una sola vez&quot;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧵 rehidratar-hilo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reinyecta hilo-mental-actual.md + el andamio (si es más fresco) al abrir/retomar/compactar (GLOBAL) — gate de frescura + edad&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📈 aviso-contexto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;al umbral ALTO del punto REAL de compact (80%/92% de autoCompactWindow o la ventana efectiva; % honesto, respeta autoCompactEnabled): VUELCA el checkpoint mecánico solito y ORDENA /checkpoint+/compact. No gotea (silencio bajo el umbral, 1 disparo + 1 escalada) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧬 aviso-drift-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;la copia GLOBAL del cerebro (hooks/libs/skills + el bloque de normas de ~/.claude/CLAUDE.md) quedó atrás de la fuente o se editó en vivo → aviso (warn-only, throttle propio por frente). El cerebro ya no viaja por-repo (solo global). Al moverse el cerebro, NUDGE a correr la DUPLA (suficiencia+coherencia; contra la firma si hay AGENTS.md, si no sugiere instanciarla) (GLOBAL)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧭 sesion-inicio&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reinyecta rama + norma + memoria al abrir (BOTH)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌾 recordar-cosechar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;espejo automático del TaskList vivo → bloque fenced en estado-proyecto.md (determinista, sin LLM) (BOTH)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;📜 Normas&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🎯 Definition of Done&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;verde técnico ≠ Done/Listo/Ya Quedó; exige QA o un OK explícito&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🪞 Doc &amp;lt;= realidad&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;cambió algo → su doc se actualiza en la tanda&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌿 Flujo de git&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ramita → MR → develop; main es release-only&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💰 Costo de delegación&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;gratis / incluido / con costo, según tu cuota&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;💡 Skills&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📦 cerrar-slice&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;build+tests+memoria al día + MR con resumen curado&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💾 checkpoint&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;vuelca el HILO a memoria para compactar sin perderlo (proactivo)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗂️ to-do&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;carga la interfaz de tareas del harness desde el backlog durable (estado-proyecto.md)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;💧 rehidratar-hilo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;relee el HILO a mano (gemelo del hook; respaldo si un update del CLI rompe el auto-rehidratado)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛟 reconstruir-contexto&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;RED DE EMERGENCIA cuando el checkpoint quedó pobre y /compact fundió el hilo: excava andamio→backlog→transcript y cierra re-volcando con checkpoint&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🗺️ diagramar&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;diagramas por destino: draw.io por defecto (skill oficial drawio) · Mermaid en .md versionado (verse en GitHub)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔬 auditar-proceso-algoritmo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;auditor experto read-only (proceso industrial + algoritmo) → hallazgos priorizados; se alimenta de los flowcharts de diagramar&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🩺 auditar-coherencia-cerebro fan-out read-only sobre el PROPIO cerebro (guards+flowcharts+doc): evasiones/huecos/drift, verificado por ejecución → loop hasta converger; modo-cerebro de auditar-proceso-algoritmo&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt; &lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧪 auditar-suficiencia-operativa&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;¿ALCANZA la doc para HACER el trabajo sin romper nada ni re-investigar? tareas reales ✅/⚠️/❌ con archivo:línea + RE-auditar tras arreglar&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🧬 auditor-semantico&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;¿el código HACE lo que queremos? Capa 1 checks deterministas (scripts/, gratis, en CI) + Capa 2 criterio LLM sobre invariantes-semanticos.yml; motor genérico, catálogo por-repo&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📐 canonizar-cerebro&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;DUEÑO del ciclo de vida del cerebro de un proyecto, 4 modos sobre 1 maquinaria: sembrar (nace nativo, sin symlinks) · canonizar (firma-árbol: git mv a dom-/dev-/ux-/qa-, verifica 1:1 con verificar-firma-canonica.sh) · consolidar (dupla → positivar → desinflar → convergencia → FIRMA) · reconciliar (semanal, minis de devs → develop)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🪶 desinflar-memorias&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;adelgaza un árbol de memorias sin perder lecciones: la narrativa se colapsa a su lección, los mitos descartados se mudan al cementerio.md (una lápida por ID content-hash 🪦#&amp;lt;id&amp;gt;)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;☀️ positivar-doc&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;reescribe answer-first: &#x27;ESTO SÍ&#x27; (método correcto) antes del &#x27;ESTO NO&#x27;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🎓 investigar-dominio&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ponte experto en un dominio (fan-out DOC-FIRST) → memorias durables + skills&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📚 construir-missing-manual&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;fabrica el manual/wiki de referencia exhaustivo que no existe (fan-out que investiga 1× y hornea) → artefacto consultable OFFLINE&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚚 reubicar-master&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;muda una sesión master COMPLETA a otro repo (brain-master → cortex) sin residuo: transcript+cwd, cerebro, slug y refs atómicas&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🛰️ coordinar-claudes&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;coordina otros masters en nombre del usuario: despierta (desde los transcripts, no masters.json) · encarga la cola · vigila (commit/colgado/muerto) · destraba · verifica con evidencia · releva OKs del usuario&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔍 zoom-screenshot&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;recorta y amplía regiones de una captura (ffmpeg) para leer texto fino ilegible&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔩 ingenieria-inversa-gui-db-navegador&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ingeniería inversa de app legacy GUI+BD: driving la UI vía navegador + diff de la BD antes/después = doc con evidencia real&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;📕 markdown-a-pdf&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;convierte .md a PDF pulido y distribuible vía md-to-pdf (npx, sin instalar) con el gotcha de --css y QA visual real&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🕹️ control-gui-remota-por-ssh&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;ver/operar una GUI remota por SSH sin VNC/RDP — screenshot/click/teclado DPI-aware; Windows·Linux·Mac completos (multi-monitor + captura por-ventana)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔁 mandato-loop&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;el MOLDE para redactar un mandato de `/loop` de épica/lote (cómo se redacta + el bloque text con todas sus secciones)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🌙 turno-nocturno&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;protocolo del turno de noche: eco del contrato, decide-dentro-de-la-cerca, grants durables a disco&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
      &lt;/table&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n0"><mxGeometry x="7.9" y="31.1" width="3178.2" height="1210.2" as="geometry"/></mxCell><mxCell id="n3" value="
      &lt;table border=&quot;0&quot; cellborder=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; color=&quot;#5fa89e&quot; bgcolor=&quot;#1b1712&quot;&gt;
        &lt;tr&gt;&lt;td colspan=&quot;2&quot; bgcolor=&quot;#2b2622&quot;&gt;&lt;font color=&quot;#d97757&quot;&gt;&lt;b&gt;valencia de color&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#7fb069&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟢&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;OK / pasa&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#e08e45&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟠&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;aviso / ASK (no bloquea)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#c9a227&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🟡&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;latente / frágil (funciona hoy, sin garantía)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#c0392b&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🔴&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;DENY / bloqueo (guard OK)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#2b2b2b&quot; border=&quot;2&quot; color=&quot;#9e9e9e&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;🚧&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;hueco / deuda (por construir)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;tr&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#f2ede6&quot;&gt;⚠&lt;/font&gt;&lt;/td&gt;&lt;td bgcolor=&quot;#1b1712&quot;&gt;&lt;font color=&quot;#cfc8c0&quot;&gt;el paso ESCRIBE git&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
      &lt;/table&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n0"><mxGeometry x="1471.2" y="1288.6" width="251.5" height="184.2" as="geometry"/></mxCell><mxCell id="n4" value="📜 🎯 Definición de LISTO&lt;br&gt;verde técnico ≠ LISTO (build+tests+memoria es necesario&lt;br&gt;pero NO suficiente): falta (1) QA del usuario o (2) su OK expreso.&lt;br&gt;Producto INSTALABLE: verde en 1 máquina ≠ LISTO (checklist multi-OS)&lt;br&gt;— hecho cumplir en 09 · 10 · 06" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="8.4" y="46.0" width="405.3" height="74.8" as="geometry"/></mxCell><mxCell id="n5" value="📜 🌿 Flujo de git&lt;br&gt;ramita → MR → develop (con squash); main es release-only;&lt;br&gt;NUNCA push directo a develop/main.&lt;br&gt;el gate confirmar ≠ «no puedes»: con tu OK, Claude mergea por CLI&lt;br&gt;— hecho cumplir en 03 · 06" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="46.0" y="789.4" width="376.0" height="77.0" as="geometry"/></mxCell><mxCell id="n6" value="📜 🪞 doc = realidad&lt;br&gt;al cambiar algo, su doc se actualiza en la MISMA tanda&lt;br&gt;(README/memoria/dashboard/comentarios)&lt;br&gt;— SIN guard DENY ni hook: self-check puro (ver árbol de decisión en 08)" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#232323;dashed=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="39.0" y="957.0" width="406.0" height="62.0" as="geometry"/></mxCell><mxCell id="n7" value="📜 🌱 Modelo MINI-DEVELOP&lt;br&gt;ramitas → rama personal/integración por merge LOCAL (sin fricción);&lt;br&gt;solo el MR a develop se gatea&lt;br&gt;— habilitado en 06" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="64.0" y="1056.0" width="382.0" height="64.2" as="geometry"/></mxCell><mxCell id="n8" value="📜 💰 Consentimiento de costo de delegación&lt;br&gt;delegar cuesta por nivel: gratis (local) / incluido (ventana 5h) /&lt;br&gt;metered (overage o API externa)&lt;br&gt;— hecho cumplir en 11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="84.2" y="1157.3" width="341.5" height="62.0" as="geometry"/></mxCell><mxCell id="n9" value="📜 🎼 Orquesta: delega y quédate en el loop&lt;br&gt;con trabajo paralelizable: fan-out + supervisión (no grind serial);&lt;br&gt;auto-reporte sin niñera&lt;br&gt;— operacionalizada en 12" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="79.3" y="1256.3" width="353.5" height="62.0" as="geometry"/></mxCell><mxCell id="n10" value="📜 🧱 Aislamiento de fan-out&lt;br&gt;todo agente que MUTA/commitea corre en worktree AISLADO,&lt;br&gt;nunca en el árbol de trabajo compartido&lt;br&gt;— hecho cumplir en 07 · 12" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="89.0" y="1355.3" width="346.0" height="62.0" as="geometry"/></mxCell><mxCell id="n11" value="📜 🧩 Toda norma nace con su mecanismo&lt;br&gt;una norma de higiene/cierre SIN hook/gate/paso operativo&lt;br&gt;= el usuario es el único enforcement → no se cumple sola" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="99.1" y="1454.2" width="325.7" height="51.5" as="geometry"/></mxCell><mxCell id="n12" value="🛡️📜 Integridad de los guardarraíles (norma SIN mecanismo LOCAL)&lt;br&gt;Claude NO afloja sus propios candados de supervisión para desatorarse;&lt;br&gt;cambiar un control exige el OK EXPLÍCITO a cambiar ESE control (≠ el OK a la acción).&lt;br&gt;NO hay hook in-repo que lo imponga: es AUTODISCIPLINA; el enforcement es EXTERNO&lt;br&gt;(el clasificador auto-mode = backstop) — aplica a merge-develop-guard 06 · proteger-arbol 07" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#c9a227;strokeWidth=2;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="473.7" y="46.0" width="512.5" height="74.8" as="geometry"/></mxCell><mxCell id="n13" value="📜 🧬 Al templatizar: DOMINIO vs regla genérica&lt;br&gt;al derivar un template de un concreto, quita el dominio pero&lt;br&gt;CONSERVA las reglas genéricas (diff PORTAR-vs-OK-EXCLUIDO)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#d97757;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="78.1" y="1542.8" width="373.8" height="49.3" as="geometry"/></mxCell><mxCell id="n14" value="📜 🗣️ Decisiones / hallazgos NO viven solo en el chat&lt;br&gt;se persisten a estado-proyecto.md/memoria en el MISMO turno&lt;br&gt;(lo que TÚ hallas → backlog; lo que se DECIDE junto con el usuario → memoria)&lt;br&gt;— SIN nudge: la mitad NUDGE de 🌾 recordar-cosechar se retiró (overhaul hooks 2026-09-18);&lt;br&gt;solo queda su ESPEJO mecánico del TaskList (leyenda; sin chart propio aún)" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#232323;dashed=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="8.0" y="1629.0" width="520.0" height="80.0" as="geometry"/></mxCell><mxCell id="n15" value="📜 🖥️ El entorno de MÁQUINA vive GLOBAL, jamás en el repo de un proyecto ni en tu slug&lt;br&gt;OS/shell/aliases/rutas de $HOME/runtime local NUNCA en el repo&lt;br&gt;(mentiría al clonar en otro OS) — vive en la memoria global per-máquina&lt;br&gt;— avisado en 03 (🔔🖥️ entorno-maquina-guard)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#e08e45;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="20.4" y="1947.0" width="495.3" height="65.0" as="geometry"/></mxCell><mxCell id="n16" value="📜 🚧 Actualiza por la HERRAMIENTA REAL, nunca el instalador a mano&lt;br&gt;un install.sh/deploy.sh corrido crudo se salta backup+atómico+sello+verificación&lt;br&gt;(excepción: --dry-run/--help/-n, o correr dentro de CI)&lt;br&gt;— no-opea sobre git; parte del fan-out de 4 en 03 · 06 · 07 (sin detalle propio)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#e08e45;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="47.4" y="1848.0" width="441.3" height="62.0" as="geometry"/></mxCell><mxCell id="n17" value="📜 🔀 Tu lista de TODOs es TU HUD — mantenla fresca&lt;br&gt;scratch de sesión (no el backlog durable); resetéala al cambiar de rama/proyecto&lt;br&gt;si diverge del backlog, MANDA estado-proyecto.md&lt;br&gt;— SIN hook: anti-drift por tu propio juicio (ver 02)" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#232323;dashed=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="46.3" y="2049.0" width="443.5" height="62.0" as="geometry"/></mxCell><mxCell id="n18" value="📜 🧬 El cerebro vive SOLO en global&lt;br&gt;los guards (hooks/libs) vienen del install GLOBAL; NO hay copia por-repo&lt;br&gt;lo que viaja por git en cada repo es la MEMORIA del proyecto + sus skills propias&lt;br&gt;— drift de la copia GLOBAL avisado en 01 · 02 (🔔🧬 aviso-drift-cerebro)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;fillColor=#2b2622;strokeColor=#e08e45;strokeWidth=1.5;fontColor=#f2ede6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="n1"><mxGeometry x="44.7" y="1746.0" width="446.5" height="65.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3431.0" y="1278.6"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n18" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n16" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="protege" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n12" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="protege" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n12" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3643.0" y="1249.3"/><mxPoint x="3555.8" y="1267.3"/></Array></mxGeometry></mxCell><mxCell id="e16" value="protege" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d97757;strokeWidth=1.4;fontColor=#cfc8c0;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="n12" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3662.0" y="1879.1"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>