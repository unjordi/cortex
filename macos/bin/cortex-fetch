#!/usr/bin/env bash
# Fetches Claude Code 5-hour and weekly usage and writes a normalized JSON
# snapshot to ~/Library/Caches/cortex/state.json.
#
# Primary source: Anthropic's OAuth usage endpoint — the same data `/usage`
# shows inside Claude Code, read with the OAuth token Claude Code already
# stores (macOS Keychain, or ~/.claude/.credentials.json). This gives the
# EXACT utilization percentages and reset times for your plan; no calibration.
#
# Fallback (offline / no credentials): ccusage cost-basis estimation against
# the *_CAP_USD calibration constants below. ccusage is also still used to
# enrich the snapshot with API-equivalent $ figures when available.
#
# macOS port of the Linux fetch script: uses BSD `date` (-v adjustments)
# and the native Caches location. The launchd agent enforces the 5-minute
# refresh floor; this script just does one fetch per invocation.

set -euo pipefail

# Source per-user caps if present (override the defaults below).
LIMITS_FILE="${CLAUDE_BRAIN_LIMITS:-$HOME/.config/cortex/limits.env}"
if [[ -f "$LIMITS_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$LIMITS_FILE"
  set +a
fi

# FALLBACK calibration only — used when the OAuth endpoint is unreachable.
# Basis = API-equivalent *cost*, not raw tokens (cache-read tokens dominate
# raw counts and are weighted ~0.1x by Anthropic's limits). Calibrate against
# /usage: CAP = ($ shown in popover) / (/usage fraction). Defaults: Max-20x.
FIVE_HOUR_CAP_USD="${FIVE_HOUR_CAP_USD:-150}"
WEEKLY_CAP_USD="${WEEKLY_CAP_USD:-9000}"
WARN_PCT="${WARN_PCT:-60}"
CRIT_PCT="${CRIT_PCT:-85}"

# Ventana (horas) para avisar "el login ya va a expirar" ANTES de que se rompa.
# Se mide sobre el REFRESH token (vida larga ~30 días), no el access token
# (vida ~8h, que Claude Code auto-refresca solo → no es señal de logout).
AUTH_EXPIRING_HORAS="${CORTEX_AUTH_EXPIRING_HORAS:-72}"

CACHE_DIR="$HOME/Library/Caches/cortex"
# Config de Claude Code: honra CLAUDE_CONFIG_DIR (si está, el .claude vive ahí), si no ~/.claude.
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -r "$CLAUDE_CONFIG_DIR/.claude.json" ]]; then
  CLAUDE_JSON="$CLAUDE_CONFIG_DIR/.claude.json"
else
  CLAUDE_JSON="$HOME/.claude.json"
fi
STATE_FILE="$CACHE_DIR/state.json"
TMP_FILE="$CACHE_DIR/state.json.tmp"

mkdir -p "$CACHE_DIR"

# Carry forward the last known REAL (oauth) reset time when this run falls
# back to cost-basis estimation — a guessed "next Monday" is wrong for
# accounts whose actual rolling weekly window doesn't land on Monday.
PREV_WEEK_RESET=""
PREV_FIVE_RESET=""
if [[ -r "$STATE_FILE" ]] && [[ "$(jq -r '.basis // empty' "$STATE_FILE" 2>/dev/null || true)" == "oauth" ]]; then
  PREV_WEEK_RESET="$(jq -r '.weekly.resets_at // empty' "$STATE_FILE" 2>/dev/null || true)"
  PREV_FIVE_RESET="$(jq -r '.five_hour.resets_at // empty' "$STATE_FILE" 2>/dev/null || true)"
fi

# --- Primary: the OAuth usage endpoint /usage itself reads -------------------

# Credenciales del LOGIN ACTIVO leídas UNA vez (llavero de macOS, luego el archivo): de aquí salen
# tanto el access token como el refreshTokenExpiresAt (señal de "el login va a expirar"). El token
# rota en cada `claude login`/`logout`, por eso preferimos el login activo sobre el env headless.
CREDS_JSON=""
CREDS_JSON="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
if [[ -z "$CREDS_JSON" && -r "$CLAUDE_DIR/.credentials.json" ]]; then
  CREDS_JSON="$(<"$CLAUDE_DIR/.credentials.json")"
fi
# Seam de prueba (test-only; default intacto si no está seteado): overridea las credenciales
# para ejercitar los estados de auth sin tocar el llavero. Seteado-pero-vacío = sin credenciales.
[[ -n "${CORTEX_FETCH_CREDS_JSON+x}" ]] && CREDS_JSON="$CORTEX_FETCH_CREDS_JSON"

# Claude Code's OAuth token: del login activo (CREDS_JSON); CLAUDE_CODE_OAUTH_TOKEN solo FALLBACK headless.
oauth_token() {
  if [[ -n "$CREDS_JSON" ]]; then
    local tok
    tok="$(jq -er '.claudeAiOauth.accessToken // empty' <<<"$CREDS_JSON" 2>/dev/null || true)"
    [[ -n "$tok" ]] && { printf '%s' "$tok"; return 0; }
  fi
  # FALLBACK headless: CLAUDE_CODE_OAUTH_TOKEN (token de larga vida de `claude setup-token`) SOLO si no
  # hay login local. Antes ganaba, pero un token estático (p. ej. heredado del entorno de launchd)
  # pisaba el cambio de cuenta → el ↻ mostraba la cuenta vieja tras un logout/login.
  [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] && { printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN"; return 0; }
  return 1
}

# Epoch-ms de expiración del REFRESH token (vida larga). Vacío si no hay credenciales legibles.
REFRESH_EXP_MS="$(jq -r '.claudeAiOauth.refreshTokenExpiresAt // empty' <<<"$CREDS_JSON" 2>/dev/null || true)"

# The account email (display only), from Claude Code's own local config —
# not part of the OAuth token, so read separately and best-effort.
account_email() {
  [[ -r "$CLAUDE_JSON" ]] || return 1
  jq -er '.oauthAccount.emailAddress // empty' "$CLAUDE_JSON"
}
ACCOUNT_EMAIL="$(account_email 2>/dev/null || true)"
ACCOUNT_UUID="$(jq -er '.oauthAccount.accountUuid // empty' "$CLAUDE_JSON" 2>/dev/null || true)"

# Account guard (opt-in): if a pinned account (uuid OR email) is configured in
# $CLAUDE_BRAIN_ACCOUNT (default ~/.config/cortex/account) and the active
# account differs, flag a mismatch so the UI warns — the CLI + Claude.app share
# one credential slot and a re-login can silently switch identities.
ACCOUNT_PIN_FILE="${CLAUDE_BRAIN_ACCOUNT:-$HOME/.config/cortex/account}"
ACCOUNT_PIN=""
[[ -r "$ACCOUNT_PIN_FILE" ]] && ACCOUNT_PIN="$(head -n1 "$ACCOUNT_PIN_FILE" | tr -d '[:space:]')"
ACCOUNT_MISMATCH=false
if [[ -n "$ACCOUNT_PIN" && "$ACCOUNT_PIN" != "$ACCOUNT_UUID" && "$ACCOUNT_PIN" != "$ACCOUNT_EMAIL" ]]; then
  ACCOUNT_MISMATCH=true
fi

TOKEN="$(oauth_token 2>/dev/null || true)"
USAGE_JSON=""
HTTP_CODE=""
if [[ -n "${CORTEX_FETCH_HTTP+x}" && -n "$TOKEN" ]]; then
  # Seam de prueba (test-only): simula la respuesta del endpoint sin red. HTTP_CODE forzado;
  # cuerpo desde CORTEX_FETCH_USAGE_FIXTURE. Gated por TOKEN como el fetch real (sin token no hay
  # consulta). No cambia nada si no está seteado.
  HTTP_CODE="$CORTEX_FETCH_HTTP"
  BODY="${CORTEX_FETCH_USAGE_FIXTURE:-}"
  if [[ "$HTTP_CODE" == "200" ]] && jq -e '.five_hour.utilization != null' <<<"$BODY" >/dev/null 2>&1; then
    USAGE_JSON="$BODY"
  fi
elif [[ -n "$TOKEN" ]]; then
  # -w anexa el código HTTP en su propia línea tras el cuerpo: así distinguimos un 401/403
  # (token rechazado → login expirado) de un fallo de RED (código vacío → transitorio).
  RESP="$(curl -sS -m 15 -w $'\n%{http_code}' "https://api.anthropic.com/api/oauth/usage" \
    -H "Authorization: Bearer $TOKEN" \
    -H "anthropic-beta: oauth-2025-04-20" 2>/dev/null || true)"
  HTTP_CODE="${RESP##*$'\n'}"
  BODY="${RESP%$'\n'*}"
  # Sanity check: 200 + JSON con la utilización de 5h. Cualquier otra cosa NO es una lectura real.
  if [[ "$HTTP_CODE" == "200" ]] && jq -e '.five_hour.utilization != null' <<<"$BODY" >/dev/null 2>&1; then
    USAGE_JSON="$BODY"
  fi
fi

# --- Estado de AUTENTICACIÓN (viaja en state.json para widget + hooks) --------
# Señales REALES, no el access token de vida corta: sin token → no_credentials;
# 401/403 → expired (rechazado); refresh token vencido → expired; refresh token
# dentro de la ventana → expiring; si no, ok. Un fallo de RED (código vacío) NO
# grita "expired": conserva ok/expiring según el refresh token.
NOW_MS=$(( $(date +%s) * 1000 ))
EXPIRING_MS=$(( AUTH_EXPIRING_HORAS * 3600 * 1000 ))
if [[ -z "$TOKEN" ]]; then
  AUTH_STATE="no_credentials"
elif [[ "$HTTP_CODE" == "401" || "$HTTP_CODE" == "403" ]]; then
  AUTH_STATE="expired"
elif [[ -n "$REFRESH_EXP_MS" ]] && (( REFRESH_EXP_MS <= NOW_MS )); then
  AUTH_STATE="expired"
elif [[ -n "$REFRESH_EXP_MS" ]] && (( REFRESH_EXP_MS <= NOW_MS + EXPIRING_MS )); then
  AUTH_STATE="expiring"
else
  AUTH_STATE="ok"
fi
# ISO de expiración del refresh token (para el aviso "expira el <fecha>"). BSD date -r <epoch-s>.
AUTH_EXPIRES_AT=""
[[ -n "$REFRESH_EXP_MS" ]] && AUTH_EXPIRES_AT="$(date -u -r $(( REFRESH_EXP_MS / 1000 )) +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"

# --- Secondary: ccusage (cost enrichment, and fallback percentages) ----------

resolve_ccusage() {
  if command -v ccusage >/dev/null 2>&1; then
    echo "ccusage"
  elif command -v npx >/dev/null 2>&1; then
    echo "npx -y ccusage@latest"
  else
    return 1
  fi
}

CCUSAGE="$(resolve_ccusage || true)"
# Seam de prueba (test-only): salta ccusage para pruebas herméticas/rápidas. Default intacto.
[[ -n "${CORTEX_FETCH_NO_CCUSAGE:-}" ]] && CCUSAGE=""

# Live pricing first: the bundled --offline table lags new models, whose
# tokens are then costed at $0 — silently deflating both the $ enrichment
# and the fallback percentages. --offline is the no-network retry.
ccusage_json() {
  local out
  out="$($CCUSAGE "$@" 2>/dev/null || true)"
  [[ -z "$out" ]] && out="$($CCUSAGE "$@" --offline 2>/dev/null || true)"
  printf '%s' "$out"
}

BLOCKS_JSON=""
WEEKLY_JSON=""
if [[ -n "$CCUSAGE" ]]; then
  BLOCKS_JSON="$(ccusage_json blocks --json --active)"
  # BSD date: 8 days ago, compact YYYYMMDD.
  SINCE="$(date -u -v-8d +%Y%m%d)"
  WEEKLY_JSON="$(ccusage_json weekly --json --since "$SINCE")"
  # Discard anything that isn't valid JSON so jq --argjson can't blow up.
  jq -e . <<<"$BLOCKS_JSON" >/dev/null 2>&1 || BLOCKS_JSON=""
  jq -e . <<<"$WEEKLY_JSON" >/dev/null 2>&1 || WEEKLY_JSON=""
fi

NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# ccusage groups weeks Monday-start; compute this week's Monday so we pick the
# CURRENT week bucket (the array is oldest-first, so [0] is last week).
DOW="$(date -u +%u)"  # 1=Mon..7=Sun
CURRENT_MONDAY="$(date -u -v-$((DOW - 1))d +%Y-%m-%d)"
# Fallback weekly reset when the OAuth endpoint (which knows the real rolling
# reset) is unavailable. On Monday this yields the *next* one (7 days ahead).
DAYS_AHEAD=$(( 8 - DOW ))
NEXT_MONDAY="$(date -u -v+"${DAYS_AHEAD}"d -v0H -v0M -v0S +%Y-%m-%dT%H:%M:%SZ)"

# A6 (auditoría 2026-10-22): esquema CANÓNICO (igual que src/bin/cortex-fetch Linux). La ventana semanal REAL
# es rolling-7d = [week_reset-7d, ahora]: en oauth week_reset = seven_day.resets_at REAL (rolling, NO el lunes —
# usar CURRENT_MONDAY inflaba la ventana ~2.5d, bug auditoría 2026-10-22); en fallback, NEXT_MONDAY. Se consulta
# ccusage `daily --since` y se SUMAN los días (el bucket semanal-lunes WEEKLY_JSON daba cost/tokens idénticos a
# la sesión). QuotaModel.swift + delegacion-comun.sh leen equiv_session_cost_usd/session_tokens_used/
# equiv_weekly_cost_usd/weekly_tokens_used/week_start. day-granular aquí (ccusage `daily --since` es por día);
# el week_start de precisión completa lo deriva jq de $week_reset - 7d.
WEEK_RESET_EFF="$NEXT_MONDAY"
if [[ -n "$USAGE_JSON" ]]; then
  _ow="$(jq -r '.seven_day.resets_at // empty' <<<"$USAGE_JSON" 2>/dev/null || true)"
  [[ -n "$_ow" ]] && WEEK_RESET_EFF="$_ow"
fi
REAL_WEEK_START="$(date -u -j -f "%Y-%m-%d" "${WEEK_RESET_EFF:0:10}" -v-7d +%Y-%m-%d)"
WEEKLY_DAILY_JSON=""
if [[ -n "$CCUSAGE" ]]; then
  WEEKLY_DAILY_JSON="$(ccusage_json daily --json --since "${REAL_WEEK_START//-/}")"
  jq -e . <<<"$WEEKLY_DAILY_JSON" >/dev/null 2>&1 || WEEKLY_DAILY_JSON=""
fi

# Discard carried-forward resets once they've actually passed (ISO-8601 "Z"
# timestamps sort lexically, so a plain string compare works here).
[[ -n "$PREV_WEEK_RESET" && "$PREV_WEEK_RESET" > "$NOW_ISO" ]] || PREV_WEEK_RESET=""
[[ -n "$PREV_FIVE_RESET" && "$PREV_FIVE_RESET" > "$NOW_ISO" ]] || PREV_FIVE_RESET=""

# --- DECISIÓN DE ESCRITURA (contrato Jordi 2026-10-21) ------------------------
# oauth FRESCO → snapshot oauth (abajo). oauth FALLA + hay lectura oauth previa →
# PRESERVAR la previa marcada stale (el estimado por costo NUNCA pisa una lectura
# real). oauth FALLA + sin previa → "no hay dato" con el estado de auth (NO inventa).
if [[ -n "$USAGE_JSON" ]]; then
jq -n \
  --argjson usage "${USAGE_JSON:-null}" \
  --argjson blocks "${BLOCKS_JSON:-null}" \
  --argjson weekly "${WEEKLY_JSON:-null}" \
  --argjson weekly_daily "${WEEKLY_DAILY_JSON:-null}" \
  --arg ts "$NOW_ISO" \
  --arg cur_week "$CURRENT_MONDAY" \
  --arg next_monday "$NEXT_MONDAY" \
  --arg prev_week_reset "$PREV_WEEK_RESET" \
  --arg prev_five_reset "$PREV_FIVE_RESET" \
  --arg email "$ACCOUNT_EMAIL" \
  --arg account_uuid "$ACCOUNT_UUID" \
  --arg auth_state "$AUTH_STATE" \
  --arg auth_expires "$AUTH_EXPIRES_AT" \
  --argjson account_mismatch "$ACCOUNT_MISMATCH" \
  --argjson five_cap "$FIVE_HOUR_CAP_USD" \
  --argjson week_cap "$WEEKLY_CAP_USD" \
  --argjson warn "$WARN_PCT" \
  --argjson crit "$CRIT_PCT" '
  def pct(used; cap): if cap > 0 then (used * 100 / cap) else 0 end;
  def round1(x): (x * 10 | floor) / 10;
  def round2(x): (x * 100 | floor) / 100;
  # "2026-06-10T00:00:00.070837+00:00" -> "2026-06-10T00:00:00Z"
  def isoz: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z");

  ($blocks.blocks[0] // null) as $blk
  | ([$weekly.weekly[]? | select((.week // .period) == $cur_week)] | first) as $wk
  | (if $blocks != null then round2(if $blk then ($blk.costUSD // 0) else 0 end) else null end) as $five_cost
  | (if $weekly_daily != null then round2(($weekly_daily.daily // []) | map(.totalCost // 0) | add // 0) else null end) as $week_cost
  | (if $usage != null then ($usage.five_hour.utilization // 0)
     else pct($five_cost // 0; $five_cap) end) as $five_pct
  | (if $usage != null then ($usage.seven_day.utilization // 0)
     else pct($week_cost // 0; $week_cap) end) as $week_pct
  | ([$five_pct, $week_pct] | max) as $max_pct
  | (if $max_pct >= $crit then "crit"
     elif $max_pct >= $warn then "warn"
     else "ok" end) as $status
  | (if ($usage != null and $usage.five_hour.resets_at != null) then ($usage.five_hour.resets_at | isoz)
     elif $blk != null then $blk.endTime
     elif $prev_five_reset != "" then $prev_five_reset
     else null end) as $five_reset
  | (if ($usage != null and $usage.seven_day.resets_at != null) then ($usage.seven_day.resets_at | isoz)
     elif $prev_week_reset != "" then $prev_week_reset
     else $next_monday end) as $week_reset
  | {
      updated_at: $ts,
      fetched_at: $ts,
      stale: false,
      status: $status,
      basis: (if $usage != null then "oauth" else "cost" end),
      auth: {
        state: $auth_state,
        expires_at: (if $auth_expires != "" then $auth_expires else null end),
        account_email: (if $email != "" then $email else null end),
        account_uuid: (if $account_uuid != "" then $account_uuid else null end)
      },
      account_email: (if $email != "" then $email else null end),
      account_uuid: (if $account_uuid != "" then $account_uuid else null end),
      account_mismatch: $account_mismatch,
      error: null,
      five_hour: (if ($usage != null or $blocks != null) then {
        percent: round1($five_pct),
        equiv_session_cost_usd: $five_cost,
        cost_cap: $five_cap,
        session_tokens_used: (if $blk != null then ($blk.totalTokens // 0) else null end),
        resets_at: $five_reset,
        is_active: (if $blk != null then ($blk.isActive // false) else true end),
        models: (if $blk != null then ($blk.models // []) else [] end)
      } else null end),
      weekly: (if ($usage != null or $weekly != null or $weekly_daily != null) then {
        percent: round1($week_pct),
        equiv_weekly_cost_usd: $week_cost,
        cost_cap: $week_cap,
        weekly_tokens_used: (if $weekly_daily != null then (($weekly_daily.daily // []) | map(.totalTokens // 0) | add // 0) else null end),
        resets_at: $week_reset,
        week_start: ($week_reset | fromdateiso8601 - 604800 | todateiso8601)
      } else null end),
      # --- Solo en modo oauth: la API expone más de lo que la GUI mostraba -----
      # limites por-modelo acotados en el tiempo (weekly_scoped con scope.model),
      # gasto REAL (dinero de bolsillo) y overage. En fallback ccusage no existen.
      limits: (if $usage != null then
        [ ($usage.limits // [])[] | {
            kind: .kind,
            model: (.scope.model.display_name // null),
            percent: .percent,
            resets_at: (if .resets_at != null then (.resets_at | isoz) else null end),
            severity: .severity,
            is_active: .is_active
          } ]
        else null end),
      spend: (if ($usage != null and $usage.spend != null) then {
        used: (if $usage.spend.used != null then ($usage.spend.used.amount_minor / pow(10; $usage.spend.used.exponent)) else null end),
        cap:  (if $usage.spend.limit != null then ($usage.spend.limit.amount_minor / pow(10; $usage.spend.limit.exponent)) else null end),
        currency: ($usage.spend.used.currency // $usage.spend.limit.currency // null),
        percent: ($usage.spend.percent // null),
        enabled: ($usage.spend.enabled // false)
      } else null end),
      extra_usage: (if ($usage != null and $usage.extra_usage != null) then {
        used_credits:  ($usage.extra_usage.used_credits // null),
        monthly_limit: ($usage.extra_usage.monthly_limit // null),
        currency:      ($usage.extra_usage.currency // null),
        utilization:   ($usage.extra_usage.utilization // null),
        enabled:       ($usage.extra_usage.is_enabled // false)
      } else null end)
    }
' > "$TMP_FILE"
mv "$TMP_FILE" "$STATE_FILE"

else
  # --- oauth NO disponible: preservar la última lectura real, o "no hay dato" ---
  case "$AUTH_STATE" in
    no_credentials) REASON="no hay cuenta logueada en el CLI de Claude" ;;
    expired)        REASON="el login de Claude expiró — re-loguéate" ;;
    *)              REASON="no se pudo contactar el endpoint OAuth (red); mostrando la última lectura real" ;;
  esac
  if [[ -r "$STATE_FILE" ]] && [[ "$(jq -r '.basis // empty' "$STATE_FILE" 2>/dev/null || true)" == "oauth" ]]; then
    # PRESERVAR: conserva números+cuenta+updated_at de la lectura real; solo la marca stale,
    # refresca el estado de auth (ACTUAL aunque los números sean viejos), sella fetched_at=ahora
    # y anota el error. El estimado por costo NO entra. La edad la calcula el lector sobre updated_at.
    jq --arg now "$NOW_ISO" --arg reason "$REASON" \
       --arg auth_state "$AUTH_STATE" --arg auth_expires "$AUTH_EXPIRES_AT" \
       --arg email "$ACCOUNT_EMAIL" --arg account_uuid "$ACCOUNT_UUID" '
       .stale = true
       | .fetched_at = $now
       | .error = $reason
       | .auth = {
           state: $auth_state,
           expires_at: (if $auth_expires != "" then $auth_expires else null end),
           account_email: (if $email != "" then $email else .account_email end),
           account_uuid: (if $account_uuid != "" then $account_uuid else null end)
         }
       ' "$STATE_FILE" > "$TMP_FILE"
    mv "$TMP_FILE" "$STATE_FILE"
  else
    # SIN lectura previa real → "no hay dato" HONESTO con el estado de auth (el widget muestra el
    # aviso + botón de re-login). NO se inventa un estimado por costo.
    jq -n --arg now "$NOW_ISO" --arg reason "$REASON" \
       --arg auth_state "$AUTH_STATE" --arg auth_expires "$AUTH_EXPIRES_AT" \
       --arg email "$ACCOUNT_EMAIL" --arg account_uuid "$ACCOUNT_UUID" '{
         updated_at: $now,
         fetched_at: $now,
         stale: true,
         status: "error",
         basis: null,
         error: $reason,
         auth: {
           state: $auth_state,
           expires_at: (if $auth_expires != "" then $auth_expires else null end),
           account_email: (if $email != "" then $email else null end),
           account_uuid: (if $account_uuid != "" then $account_uuid else null end)
         },
         account_email: null,
         five_hour: null,
         weekly: null
       }' > "$TMP_FILE"
    mv "$TMP_FILE" "$STATE_FILE"
  fi
fi

# --- Stats para las pestañas Resumen / Modelos (ccusage local) ---------------
# Datos LOCALES de Claude Code de esta máquina (no la cuenta global de claude.ai).
# Se escriben aparte en stats.json para no inflar el state.json de límites.
DAILY_JSON=""
if [[ -n "$CCUSAGE" ]]; then
  DAILY_JSON="$(ccusage_json daily --json --breakdown)"
  jq -e . <<<"$DAILY_JSON" >/dev/null 2>&1 || DAILY_JSON=""
fi
if [[ -n "$DAILY_JSON" ]]; then
  # --- Fase 2: sesiones, mensajes y hora pico desde transcripts crudos --------
  # grep/awk (NO jq) porque ~/.claude/projects puede pesar cientos de MB.
  # BSD grep (macOS) soporta -r/-c/-h/-o/-E/--include igual que GNU grep.
  PROJ="$CLAUDE_DIR/projects"
  SESSIONS=0; MESSAGES=0; PEAK_HOUR=-1; DAY_MSG_JSON="{}"
  if [[ -d "$PROJ" ]]; then
    SESSIONS=$(( $(find "$PROJ" -name '*.jsonl' 2>/dev/null | wc -l) ))
    MESSAGES=$(grep -rcE '"type":"(assistant|user)"' "$PROJ" --include='*.jsonl' 2>/dev/null \
               | awk -F: '{s+=$NF} END{print s+0}')
    # offset local en horas (ej -0600 -> -6); base-10 forzada para evitar octal
    Z=$(date +%z); SG=${Z:0:1}; HH=${Z:1:2}; OFF=$((10#$HH)); [[ "$SG" == "-" ]] && OFF=$((-OFF))
    PEAK_HOUR=$(grep -rhoE '"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}' "$PROJ" --include='*.jsonl' 2>/dev/null \
      | grep -oE 'T[0-9]{2}$' | tr -d 'T' \
      | awk -v off="$OFF" 'BEGIN{m=-1;ph=-1} {h=($1+off+24)%24; c[h]++} END{for(i=0;i<24;i++) if(c[i]>m){m=c[i];ph=i}; print ph}')
    [[ -z "$PEAK_HOUR" ]] && PEAK_HOUR=-1
    # mensajes por DÍA local (para el filtro de rango del Resumen): user/assistant bucketizados.
    DAY_MSG_JSON="$(grep -rhE '"type":"(assistant|user)"' "$PROJ" --include='*.jsonl' 2>/dev/null | awk -v off="$OFF" '
      function isLeap(y){return (y%4==0&&y%100!=0)||(y%400==0)}
      function dim(y,m,  a){split("31 28 31 30 31 30 31 31 30 31 30 31",a," "); return (m==2&&isLeap(y))?29:a[m]+0}
      function shift(y,m,d,dl,  nd,nm,ny){nd=d+dl;ny=y;nm=m; if(nd<1){nm=m-1; if(nm<1){nm=12;ny=y-1} nd=dim(ny,nm)} else if(nd>dim(y,m)){nd=1;nm=m+1; if(nm>12){nm=1;ny=y+1}} return sprintf("%04d-%02d-%02d",ny,nm,nd)}
      { if(match($0,/"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}/)){ts=substr($0,RSTART+13,13); y=substr(ts,1,4)+0;mo=substr(ts,6,2)+0;da=substr(ts,9,2)+0;hh=substr(ts,12,2)+0} else next
        lh=hh+off; if(lh<0)dt=shift(y,mo,da,-1); else if(lh>=24)dt=shift(y,mo,da,1); else dt=sprintf("%04d-%02d-%02d",y,mo,da); M[dt]++ }
      END{ printf "{"; first=1; for(d in M){ printf "%s\"%s\":%d",(first?"":","),d,M[d]; first=0 } printf "}" }
    ')"
    jq -e . <<<"$DAY_MSG_JSON" >/dev/null 2>&1 || DAY_MSG_JSON="{}"
  fi

  # --- Fase 3: uso por proyecto (carpeta ~/.claude/projects/<slug>) -----------
  # ccusage no separa por proyecto (ni `daily` ni `session` traen la ruta) ->
  # se agrega a mano desde los mismos jsonl crudos de fase 2. El nombre del
  # proyecto se toma del "cwd" REAL que cada turno registra en su jsonl (la misma
  # fuente que sessions-extract.js -> stats y la lista de sesiones coinciden):
  #   · basename del cwd, tras colapsar cualquier subdir/worktree bajo ".claude/"
  #     a la raíz del repo (p. ej. .../repo/.claude/worktrees/x -> "repo");
  #   · un cwd efímero en /tmp o /private/tmp -> bucket "(worktrees)";
  #   · si un turno no trajo cwd -> último segmento del slug (fallback).
  # (ANTES: se agrupaba por el SLUG del directorio mapeado contra ~/.claude.json
  #  .projects; fallaba porque el slug normaliza "_"/"." a "-" -> no casaba su
  #  propio repo, y la entrada $HOME (slug "-home-<user>") era prefijo de TODO ->
  #  colapsaba todos los proyectos en uno. El cwd real no sufre ninguna de las dos.)
  # Un alias opcional (~/.claude/proyectos-alias.json) renombra el nombre final.
  # Alias opcional: mapa {"<nombre>":"<alias>"}; tolera que no exista.
  PROJECT_ALIAS_JSON="{}"
  if [[ -r "$CLAUDE_DIR/proyectos-alias.json" ]]; then
    PROJECT_ALIAS_JSON="$(jq -c '.' "$CLAUDE_DIR/proyectos-alias.json" 2>/dev/null || echo '{}')"
    jq -e . <<<"$PROJECT_ALIAS_JSON" >/dev/null 2>&1 || PROJECT_ALIAS_JSON="{}"
  fi
  PROJECT_DAY_TSV=""
  if [[ -d "$PROJ" ]]; then
    for d in "$PROJ"/*/; do
      [[ -d "$d" ]] || continue
      slug="$(basename "$d")"
      # Bucket by LOCAL calendar day (same convention ccusage's daily/--breakdown
      # uses) — the raw timestamp is UTC, so an hour near midnight can land on
      # the previous/next local day. $OFF (local UTC offset, from fase 2 arriba)
      # only ever shifts by one day either way, so a plain day rollover suffices.
      PROJECT_DAY_TSV+="$( { grep -rh '"usage":{' "$d" --include='*.jsonl' 2>/dev/null || true; } | awk -v slug="$slug" -v off="$OFF" '
        function isLeap(y) { return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0) }
        function daysInMonth(y, m,    dim) {
          split("31 28 31 30 31 30 31 31 30 31 30 31", dim, " ")
          if (m == 2 && isLeap(y)) return 29
          return dim[m] + 0
        }
        function shiftDay(y, m, d, delta,   ny, nm, nd) {
          nd = d + delta; ny = y; nm = m
          if (nd < 1) {
            nm = m - 1; if (nm < 1) { nm = 12; ny = y - 1 }
            nd = daysInMonth(ny, nm)
          } else if (nd > daysInMonth(y, m)) {
            nd = 1; nm = m + 1; if (nm > 12) { nm = 1; ny = y + 1 }
          }
          return sprintf("%04d-%02d-%02d", ny, nm, nd)
        }
        # Cada carpeta ~/.claude/projects/<slug> ES UN proyecto (el cwd de ARRANQUE
        # de sus sesiones) -> se agrega por DÍA dentro de la carpeta (no por cwd de
        # cada turno, que puede ser un subdir o un worktree). El NOMBRE bonito del
        # proyecto = basename del cwd más RAÍZ (menor profundidad) visto en la
        # carpeta, tras colapsar lo que esté bajo ".claude/" y normalizar los
        # backslashes de rutas Windows heredadas; si nunca hubo cwd, el slug.
        BEGIN { ns = split(slug, sp, "-"); slugLast = (ns > 0 ? sp[ns] : slug); bestDepth = 1000000; bestName = ""; soloTmp = 0 }
        {
          # Claude Code logs one jsonl line per CONTENT BLOCK de un turno del
          # asistente (thinking/tool_use/text), cada uno repitiendo el MISMO
          # message.id y el MISMO usage acumulado — sin dedupe, una respuesta
          # multi-bloque triplica el conteo de tokens.
          if (match($0, /"id":"msg_[A-Za-z0-9]+"/)) { id = substr($0, RSTART, RLENGTH) } else next
          if (id in seen) next
          seen[id] = 1
          if (match($0, /"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}/)) {
            ts = substr($0, RSTART + 13, 13)
            y = substr(ts,1,4) + 0; mo = substr(ts,6,2) + 0; da = substr(ts,9,2) + 0; hh = substr(ts,12,2) + 0
          } else next
          lh = hh + off
          if (lh < 0)       date = shiftDay(y, mo, da, -1)
          else if (lh >= 24) date = shiftDay(y, mo, da, 1)
          else               date = sprintf("%04d-%02d-%02d", y, mo, da)
          if (match($0, /"cwd":"[^"]*"/)) {
            cwd = substr($0, RSTART + 7, RLENGTH - 8)
            if (cwd ~ /^\/(private\/)?tmp\//) soloTmp = 1
            else {
              gsub(/\\\\/, "/", cwd)                 # rutas Windows heredadas: "\\" -> "/"
              n = split("/.claude/ /.git-worktrees/ /.worktrees/ /.cortex-wt/", wd, " "); for (k = 1; k <= n; k++) { ix = index(cwd, wd[k]); if (ix > 0) cwd = substr(cwd, 1, ix - 1) }
              sub(/[\/]+$/, "", cwd)
              nd = split(cwd, pp, "/"); b = (nd > 0 ? pp[nd] : "")
              if (b != "" && nd < bestDepth) { bestDepth = nd; bestName = b }
            }
          }
          inv = 0; outv = 0
          if (match($0, /"input_tokens":[0-9]+/))  { s = substr($0, RSTART, RLENGTH); sub(/^"input_tokens":/, "", s);  inv  = s + 0 }
          if (match($0, /"output_tokens":[0-9]+/)) { s = substr($0, RSTART, RLENGTH); sub(/^"output_tokens":/, "", s); outv = s + 0 }
          I[date] += inv; O[date] += outv
        }
        END { name = (bestName != "" ? bestName : (soloTmp ? "(worktrees)" : slugLast)); for (dt in I) printf "%s\t%s\t%d\t%d\n", name, dt, I[dt], O[dt] + 0 }
      ')"$'\n'
    done
  fi
  PROJECT_STATS_JSON='{"projects":[],"by_day":{}}'
  if [[ -n "${PROJECT_DAY_TSV// /}" ]]; then
    PROJECT_STATS_JSON="$(printf '%s' "$PROJECT_DAY_TSV" | jq -R -s \
        --argjson aliases "$PROJECT_ALIAS_JSON" '
      # La 1ª columna del TSV YA es el nombre del proyecto (basename del cwd real,
      # calculado en el awk de arriba); aquí solo se aplica el alias opcional y se
      # agrega por proyecto y por día.
      (split("\n") | map(select(length > 0) | split("\t"))
        | map({name: ($aliases[.[0]] // .[0]), date: .[1],
               in_tok: (.[2]|tonumber), out_tok: (.[3]|tonumber)})
      ) as $rows
      | ($rows | group_by(.name)
          | map({project: .[0].name, in_tok: (map(.in_tok) | add), out_tok: (map(.out_tok) | add)})
          | map(. + {tot: (.in_tok + .out_tok)})
          | sort_by(-.tot)) as $projs
      | (($projs | map(.tot) | add) // 0) as $grand
      | ($projs | map(. + {pct: (if $grand > 0 then (.tot * 100 / $grand) else 0 end)})) as $projects
      | ($rows | group_by(.date)
          | map({
              key: .[0].date,
              value: (group_by(.name)
                | map({project: .[0].name,
                       in_tok:  (map(.in_tok)  | add),
                       out_tok: (map(.out_tok) | add),
                       tokens:  (map(.in_tok + .out_tok) | add)})
                | sort_by(-.tokens))
            })
          | from_entries) as $by_day
      | {projects: $projects, by_day: $by_day}
    ' 2>/dev/null || echo '{"projects":[],"by_day":{}}')"
    jq -e . <<<"$PROJECT_STATS_JSON" >/dev/null 2>&1 || PROJECT_STATS_JSON='{"projects":[],"by_day":{}}'
  fi

  STATS_TMP="$CACHE_DIR/stats.json.tmp"
  if jq -n --argjson daily "$DAILY_JSON" --arg ts "$NOW_ISO" \
        --argjson sessions "$SESSIONS" --argjson messages "$MESSAGES" --argjson peak "$PEAK_HOUR" \
        --argjson proj "$PROJECT_STATS_JSON" --argjson msgday "$DAY_MSG_JSON" '
      # "tokens" mostrados = in+out (sin cache, que domina los totales crudos)
      ($daily.daily // []) as $d
      | ($d | map({
          date: .period,
          in_tok:  (.inputTokens  // 0),
          out_tok: (.outputTokens // 0),
          tokens:  ((.inputTokens // 0) + (.outputTokens // 0)),
          cost:    (.totalCost // 0),
          messages: ($msgday[.period] // 0),
          models:  (.modelBreakdowns // [] | map({
                      model:   .modelName,
                      in_tok:  (.inputTokens  // 0),
                      out_tok: (.outputTokens // 0),
                      tokens:  ((.inputTokens // 0) + (.outputTokens // 0))
                   })),
          projects: ($proj.by_day[.period] // [])
        })) as $days
      # agregado por modelo (suma de todos los días)
      | ([ $d[].modelBreakdowns[]? ]
          | group_by(.modelName)
          | map({
              model:   .[0].modelName,
              in_tok:  (map(.inputTokens  // 0) | add),
              out_tok: (map(.outputTokens // 0) | add),
              cost:    (map(.cost // 0) | add)
            })
          | map(. + {tot: (.in_tok + .out_tok)})
          | sort_by(-.tot)) as $models
      | (($models | map(.tot) | add) // 0) as $grand
      | {
          updated_at: $ts,
          days: $days,
          models: ($models | map(. + {
            pct: (if $grand > 0 then (.tot * 100 / $grand) else 0 end)
          })),
          projects: $proj.projects,
          summary: {
            total_tokens: $grand,
            total_cost:   (($models | map(.cost) | add) // 0),
            active_days:  ($days | map(select(.tokens > 0)) | length),
            favorite_model: ($models | (first // {}) | .model),
            sessions:  $sessions,
            messages:  $messages,
            peak_hour: $peak
          }
        }
    ' > "$STATS_TMP" 2>/dev/null; then
    mv "$STATS_TMP" "$CACHE_DIR/stats.json"
  else
    rm -f "$STATS_TMP"
  fi
fi

# --- Chats del app de escritorio (fuente A local) -> chats.json --------------
# chats-extract.js lee el cache local de IndexedDB del app de escritorio (Snappy + V8), SIN red ni
# cookies. Fail-open: sin node / sin el script / sin app de escritorio instalada -> no hay chats.json
# (la pestaña Chats queda vacía). Se instala junto al fetch (mismo dir).
CHATS_EXTRACT="$(cd "$(dirname "$0")" && pwd)/chats-extract.js"
if command -v node >/dev/null 2>&1 && [[ -f "$CHATS_EXTRACT" ]]; then
  CHATS_JSON="$(node "$CHATS_EXTRACT" 2>/dev/null || true)"
  if [[ -n "$CHATS_JSON" ]] && jq -e 'type=="array"' <<<"$CHATS_JSON" >/dev/null 2>&1; then
    printf '%s' "$CHATS_JSON" > "$CACHE_DIR/chats.json.tmp" && mv "$CACHE_DIR/chats.json.tmp" "$CACHE_DIR/chats.json"
  fi
fi

# --- Sesiones de Claude Code por proyecto (para el dropdown de "resumir") -> sessions.json ---
# sessions-extract.js lista las sesiones (~/.claude/projects/<slug>/*.jsonl) con id/cwd/fecha/label.
# Fail-open: sin node / sin el script -> no hay sessions.json (el dropdown sale vacío).
SESSIONS_EXTRACT="$(cd "$(dirname "$0")" && pwd)/sessions-extract.js"
if command -v node >/dev/null 2>&1 && [[ -f "$SESSIONS_EXTRACT" ]]; then
  SESS_JSON="$(node "$SESSIONS_EXTRACT" 2>/dev/null || true)"
  if [[ -n "$SESS_JSON" ]] && jq -e 'type=="array"' <<<"$SESS_JSON" >/dev/null 2>&1; then
    printf '%s' "$SESS_JSON" > "$CACHE_DIR/sessions.json.tmp" && mv "$CACHE_DIR/sessions.json.tmp" "$CACHE_DIR/sessions.json"
  fi
fi

# --- (e) Sync entre máquinas vía carpeta de nube -----------------------------------------------
# OPT-IN: se activa solo si SYNC_DIR (en limits.env) o CLAUDE_BRAIN_SYNC_DIR está puesto — así ninguna
# máquina sube nada sin que lo actives. Valor "auto" autodetecta Google Drive. Cada máquina escribe su
# snapshot <host>.json en la carpeta (que tu nube ya replica), lee los de TODAS las de la MISMA cuenta y
# fusiona -> stats-global.json (lo consume el toggle "todas" del widget). Fail-open en cada paso.
resolve_sync_dir() {
  local v="${CLAUDE_BRAIN_SYNC_DIR:-${SYNC_DIR:-}}"
  [[ -z "$v" ]] && return                         # no configurado -> off
  if [[ "$v" != "auto" ]]; then printf '%s' "$v"; return; fi
  local d                                          # auto: Google Drive por OS (mac CloudStorage, o clásico)
  for d in "$HOME/Library/CloudStorage/GoogleDrive-"*/"Mi unidad" \
           "$HOME/Library/CloudStorage/GoogleDrive-"*/"My Drive" \
           "$HOME/Google Drive" "$HOME/Mi unidad" "$HOME/GoogleDrive"; do
    [[ -d "$d" ]] && { printf '%s/cortex-sync' "$d"; return; }
  done
}
SYNC_DIR_RESOLVED="$(resolve_sync_dir || true)"
if [[ -n "${SYNC_DIR_RESOLVED:-}" && -f "$CACHE_DIR/stats.json" ]] && mkdir -p "$SYNC_DIR_RESOLVED" 2>/dev/null; then
  # machine-id ESTABLE: el snapshot se nombra por este id, NO por el hostname (macOS lo cambia por
  # red/bonjour -> la misma Mac generaba varios snapshots y el merge multiplicaba). Se genera 1 vez y
  # se guarda; sobrevive a cambios de hostname. El nombre bonito (ComputerName) viaja como dato aparte.
  MID_FILE="$(dirname "$LIMITS_FILE")/machine-id"
  MACHINE_ID="$(cat "$MID_FILE" 2>/dev/null || true)"
  if [[ -z "$MACHINE_ID" ]]; then
    MACHINE_ID="$(uuidgen 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    [[ -z "$MACHINE_ID" ]] && MACHINE_ID="$(hostname -s 2>/dev/null || echo host)"
    mkdir -p "$(dirname "$MID_FILE")" 2>/dev/null && printf '%s\n' "$MACHINE_ID" > "$MID_FILE" 2>/dev/null || true
  fi
  MACHINE_NAME="$(scutil --get ComputerName 2>/dev/null || hostname -s 2>/dev/null || echo "$MACHINE_ID")"
  ACCT="$(jq -r '.account_uuid // .account_email // "default"' "$STATE_FILE" 2>/dev/null || echo default)"
  # snapshot propio = stats.json + metadatos de máquina/cuenta (escritura atómica). Filename = machine-id.
  SNAP_TMP="$SYNC_DIR_RESOLVED/.$MACHINE_ID.json.tmp"
  if jq --arg id "$MACHINE_ID" --arg name "$MACHINE_NAME" --arg ts "$NOW_ISO" --arg acct "$ACCT" \
        '{machine_id:$id, machine:$name, updated_at:$ts, account:$acct, stats:.}' "$CACHE_DIR/stats.json" > "$SNAP_TMP" 2>/dev/null; then
    mv "$SNAP_TMP" "$SYNC_DIR_RESOLVED/$MACHINE_ID.json"
  else
    rm -f "$SNAP_TMP"
  fi
  # merge de todos los snapshots de la MISMA cuenta -> stats-global.json (suma por día/modelo/proyecto).
  GLOBAL_TMP="$CACHE_DIR/stats-global.json.tmp"
  # (e) SYNC_COMBINE_ALL=1 → combina snapshots de TODAS las cuentas de la carpeta de sync (misma persona,
  # varias cuentas: p. ej. una por máquina). Sin él, solo la cuenta local (default: aísla cuentas ajenas).
  SYNC_COMBINE=$([ "${SYNC_COMBINE_ALL:-}" = "1" ] && echo true || echo false)
  if jq -s --arg acct "$ACCT" --argjson comb "$SYNC_COMBINE" --arg ts "$NOW_ISO" '
      (if $comb then . else map(select(.account == $acct)) end) as $snaps
      | ([ $snaps[].stats.days[]? ] | group_by(.date) | map({
            date: .[0].date,
            in_tok:  (map(.in_tok  // 0) | add), out_tok: (map(.out_tok // 0) | add),
            tokens:  (map(.tokens  // 0) | add), cost:    (map(.cost    // 0) | add),
            messages:(map(.messages// 0) | add),
            models:  ([.[].models[]?]  | group_by(.model)   | map({model:.[0].model,     in_tok:(map(.in_tok//0)|add), out_tok:(map(.out_tok//0)|add), tokens:(map(.tokens//0)|add)})),
            projects:([.[].projects[]?]| group_by(.project) | map({project:.[0].project, in_tok:(map(.in_tok//0)|add), out_tok:(map(.out_tok//0)|add), tokens:(map(.tokens//0)|add)}))
          }) | sort_by(.date)) as $days
      | ([ $days[].models[] ] | group_by(.model) | map({model:.[0].model, in_tok:(map(.in_tok)|add), out_tok:(map(.out_tok)|add)}) | map(.+{tot:(.in_tok+.out_tok)}) | sort_by(-.tot)) as $models
      | (($models|map(.tot)|add)//0) as $grand
      | ([ $days[].projects[] ] | group_by(.project) | map({project:.[0].project, in_tok:(map(.in_tok)|add), out_tok:(map(.out_tok)|add)}) | map(.+{tot:(.in_tok+.out_tok), pct:(if $grand>0 then (.in_tok+.out_tok)*100/$grand else 0 end)}) | sort_by(-.tot)) as $projects
      | {
          updated_at: $ts,
          machines: ($snaps | map({name:.machine, updated_at:.updated_at, tokens:(.stats.summary.total_tokens // 0)}) | sort_by(-.tokens)),
          days: $days,
          models: ($models | map(.+{pct:(if $grand>0 then .tot*100/$grand else 0 end)})),
          projects: $projects,
          summary: {
            total_tokens: $grand,
            total_cost:   (($days|map(.cost)|add)//0),
            active_days:  ($days|map(select(.tokens>0))|length),
            favorite_model: ($models|(first//{})|.model),
            sessions:  (($snaps|map(.stats.summary.sessions // 0))|add),
            messages:  (($days|map(.messages))|add // 0),
            peak_hour: null
          }
        }
    ' "$SYNC_DIR_RESOLVED"/*.json > "$GLOBAL_TMP" 2>/dev/null && [[ -s "$GLOBAL_TMP" ]]; then
    mv "$GLOBAL_TMP" "$CACHE_DIR/stats-global.json"
  else
    rm -f "$GLOBAL_TMP"
  fi
fi
